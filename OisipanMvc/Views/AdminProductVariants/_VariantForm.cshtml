@model FrontendMvc.Models.ProductVariantAdminViewModel

<div class="row g-3">
    <div class="col-12">
        <label asp-for="ProductId" class="form-label"></label>
        <select asp-for="ProductId" asp-items="Model.Products" class="form-select">
            <option value="0">-- Chọn sản phẩm --</option>
        </select>
        <span asp-validation-for="ProductId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Size" class="form-label">Size</label>
        <input asp-for="Size" class="form-control" placeholder="S, M, L..." />
        <span asp-validation-for="Size" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Filling" class="form-label">Nhân bánh</label>
        <input asp-for="Filling" class="form-control" placeholder="Phô mai, socola..." />
        <span asp-validation-for="Filling" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="AdditionalPrice" class="form-label">Giá cộng thêm</label>
        <input asp-for="AdditionalPrice" class="form-control" type="number" min="0" step="1000" />
        <span asp-validation-for="AdditionalPrice" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Quantity" class="form-label">Tồn kho</label>
        <input asp-for="Quantity" class="form-control" type="number" min="0" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Đang bán</label>
        </div>
    </div>
</div>

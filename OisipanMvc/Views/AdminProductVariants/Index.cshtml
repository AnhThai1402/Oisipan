@model List<FrontendMvc.Models.ProductVariantAdminViewModel>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Quản lý biến thể";
    var products = ViewBag.Products as List<SelectListItem> ?? new();
    int? selectedProductId = ViewBag.SelectedProductId;
}

<div class="admin-page-header">
    <div>
        <p class="auth-eyebrow">Admin</p>
        <h1>Quản lý biến thể</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create" asp-route-productId="@selectedProductId">Thêm biến thể</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label for="productId" class="form-label">Lọc theo sản phẩm</label>
        <select id="productId" name="productId" class="form-select" asp-items="products">
            <option value="">Tất cả sản phẩm</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<div class="table-responsive admin-table-wrap">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Size</th>
                <th>Nhân bánh</th>
                <th>Giá bán</th>
                <th>Tồn kho</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var variant in Model)
                {
                    <tr>
                        <td><strong>@variant.ProductName</strong></td>
                        <td>@variant.Size</td>
                        <td>@variant.Filling</td>
                        <td>+@variant.AdditionalPrice.ToString("N0") đ</td>
                        <td>@variant.Quantity</td>
                        <td>
                            <span class="badge @(variant.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(variant.IsActive ? "Đang bán" : "Tạm ẩn")
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@variant.ProductVariantId">Sửa</a>
                            <form asp-action="Delete"
                                  asp-route-id="@variant.ProductVariantId"
                                  asp-route-productId="@selectedProductId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa biến thể này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">Chưa có biến thể nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

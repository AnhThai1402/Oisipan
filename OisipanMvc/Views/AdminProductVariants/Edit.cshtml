@model FrontendMvc.Models.ProductVariantAdminViewModel

@{
    ViewData["Title"] = "Sửa biến thể";
}

<div class="admin-form">
    <h1>Sửa biến thể</h1>

    <form asp-action="Edit" asp-route-id="@Model.ProductVariantId" method="post" novalidate>
        <input asp-for="ProductVariantId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <partial name="_VariantForm" model="Model" />

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-productId="@Model.ProductId">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model FrontendMvc.Models.OrderAdminViewModel
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #OP-{Model.OrderId:N}";

    var statuses = new[] { "Chờ xác nhận", "Đã xác nhận", "Đang chuẩn bị", "Đang giao", "Hoàn thành" };
    var currentIndex = Array.IndexOf(statuses, Model.Status);
    if (Model.Status == "Đã giao") currentIndex = 4;
    if (currentIndex < 0) currentIndex = 0;

    var isCancelled = Model.Status == "Đã hủy";
    var progressPercent = isCancelled ? 0 : currentIndex * 80.0 / (statuses.Length - 1);
    var statusClass = Model.Status == "Chờ xác nhận" ? "pending" : Model.Status == "Đã hủy" ? "cancelled" : "approved";
}

<section class="order-detail-page">
    <div class="order-detail-shell">
        <header class="order-detail-hero">
            <div>
                <span class="order-eyebrow">Đơn hàng của bạn</span>
                <h1>Chi tiết đơn hàng</h1>
                <div class="order-meta-line">
                    <span class="order-code">#OP-@Model.OrderId.ToString("N")</span>
                    <span><i class="bi bi-calendar2-check"></i> @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
            <a asp-controller="Orders" asp-action="Index" class="order-back-link">
                <i class="bi bi-arrow-left"></i>
                <span>Quay lại</span>
            </a>
        </header>

        @if (TempData["Message"] is string successMessage)
        {
            <div class="order-alert success" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>@successMessage</span>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="order-alert error" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@errorMessage</span>
            </div>
        }

        @if (isCancelled)
        {
            <div class="order-tracker cancelled">
                <div class="tracker-cancelled-state">
                    <span class="tracker-icon"><i class="bi bi-x-lg"></i></span>
                    <div>
                        <strong>Đơn hàng đã bị hủy</strong>
                        <small>Yêu cầu này không còn tiếp tục giao.</small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="order-tracker" style="--progress-width: @progressPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                <div class="tracker-rail"></div>
                <div class="tracker-progress"></div>

                @for (var i = 0; i < statuses.Length; i++)
                {
                    var icons = new[] { "bi-receipt", "bi-check2-circle", "bi-box2-heart", "bi-truck", "bi-house-heart" };
                    var stepClass = currentIndex >= i ? (currentIndex == i ? "current" : "active") : "";
                    <div class="tracker-step @stepClass">
                        <span class="tracker-icon"><i class="bi @icons[i]"></i></span>
                        <span class="tracker-label">@statuses[i]</span>
                    </div>
                }
            </div>
        }

        @if (Model.Status == "Đang giao")
        {
            <div class="receipt-callout">
                <div>
                    <h2><i class="bi bi-box2-heart"></i> Đơn hàng đang đến!</h2>
                    <p>Vui lòng xác nhận sau khi bạn đã nhận được hàng.</p>
                </div>
                <form method="post" asp-controller="Orders" asp-action="ConfirmReceipt" asp-route-id="@Model.OrderId">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-primary receipt-button">
                        <i class="bi bi-check-circle"></i>
                        Đã nhận hàng
                    </button>
                </form>
            </div>
        }

        <article class="order-card product-card-detail">
            <div class="order-card-head">
                <span class="card-icon"><i class="bi bi-basket-fill"></i></span>
                <div>
                    <h2>Chi tiết sản phẩm</h2>
                    <p>@Model.OrderItems.Count sản phẩm trong đơn</p>
                </div>
            </div>
            <div class="order-products-wrap">
                <table class="order-products-table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <span class="product-thumb"><i class="bi bi-bag-heart"></i></span>
                                        <div>
                                            <strong>@item.ProductName</strong>
                                            @if (!string.IsNullOrEmpty(item.ProductName))
                                            {
                                                <small>Phân loại: @item.ProductName</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N0")đ</td>
                                <td><strong>@item.Total.ToString("N0")đ</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <div class="order-summary-grid">
            <article class="order-card">
                <div class="order-card-head">
                    <span class="card-icon"><i class="bi bi-info-circle"></i></span>
                    <div>
                        <h2>Thông tin đơn hàng</h2>
                        <p>Thông tin giao nhận và thanh toán</p>
                    </div>
                </div>
                <div class="detail-list">
                    <div class="detail-row">
                        <span>Trạng thái</span>
                        <strong class="order-status-pill @statusClass">@Model.Status</strong>
                    </div>
                    <div class="detail-row">
                        <span>Phương thức thanh toán</span>
                        <strong>@Model.PaymentMethod</strong>
                    </div>
                    <div class="detail-row">
                        <span>Địa chỉ giao hàng</span>
                        <strong>@Model.ShippingAddress</strong>
                    </div>
                    <div class="detail-row">
                        <span>Số điện thoại</span>
                        <strong>@Model.CustomerPhone</strong>
                    </div>
                </div>
            </article>

            <article class="order-card total-card">
                <div class="order-card-head">
                    <span class="card-icon"><i class="bi bi-calculator"></i></span>
                    <div>
                        <h2>Tổng tiền</h2>
                        <p>Tạm tính và thanh toán cuối</p>
                    </div>
                </div>
                <div class="detail-list">
                    <div class="detail-row">
                        <span>Tổng sản phẩm</span>
                        <strong>@Model.TotalAmount.ToString("N0")đ</strong>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="detail-row discount-row">
                            <span>Giảm giá</span>
                            <strong>-@Model.DiscountAmount.ToString("N0")đ</strong>
                        </div>
                    }
                    <div class="detail-row grand-total-row">
                        <span>Thanh toán</span>
                        <strong>@Model.FinalAmount.ToString("N0")đ</strong>
                    </div>
                </div>
            </article>
        </div>

        @if (Model.Status == "Đang giao")
        {
            <article class="order-card action-panel" style="border: 2px solid var(--accent-green); margin-bottom: 2rem;">
                <div class="order-card-head">
                    <span class="card-icon" style="background-color: var(--accent-green); color: white;"><i class="bi bi-box-seam-fill"></i></span>
                    <div>
                        <h2 style="color: var(--accent-green);">Xác nhận nhận hàng</h2>
                        <p>Vui lòng xác nhận sau khi bạn đã nhận đủ hàng và hài lòng với sản phẩm.</p>
                    </div>
                </div>
                <form method="post" action="/Orders/ConfirmReceipt/@Model.OrderId" onsubmit="return confirm('Bạn xác nhận đã nhận được hàng và đơn hàng còn nguyên vẹn chứ? Hành động này không thể hoàn tác.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="background-color: var(--accent-green); color: white; width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 1.1rem; margin-top: 10px; transition: 0.3s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                        <i class="bi bi-check-circle-fill"></i>
                        Đã nhận hàng
                    </button>
                </form>
            </article>
        }

        @if (Model.Status != "Đã giao" && Model.Status != "Đã hủy")
        {
            <article class="order-card cancellation-panel">
                <div class="order-card-head">
                    <span class="card-icon danger"><i class="bi bi-exclamation-triangle-fill"></i></span>
                    <div>
                        <h2>Yêu cầu hủy đơn hàng</h2>
                        <p>Gửi yêu cầu nếu đơn hàng cần thay đổi.</p>
                    </div>
                </div>

                @if (Model.CancellationRequests.Any())
                {
                    <div class="cancel-history">
                        <h3>Lịch sử yêu cầu</h3>
                        @foreach (var req in Model.CancellationRequests.OrderByDescending(r => r.CancelledAt))
                        {
                            var itemClass = req.Status == "Approved" ? "approved" : req.Status == "Rejected" ? "rejected" : "pending";
                            var statusIcon = req.Status == "Approved" ? "bi-check-circle-fill" : req.Status == "Rejected" ? "bi-x-circle-fill" : "bi-hourglass-split";
                            var statusBadge = req.Status == "Approved" ? "Đã chấp nhận" : req.Status == "Rejected" ? "Bị từ chối" : "Chờ xử lý";
                            <div class="cancel-request @itemClass">
                                <div class="cancel-request-top">
                                    <span><i class="bi @statusIcon"></i> @statusBadge</span>
                                    <small>@req.CancelledAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <div class="cancel-note">
                                    <strong>Lý do</strong>
                                    <p>@req.Reason</p>
                                </div>
                                @if (!string.IsNullOrEmpty(req.AdminNote))
                                {
                                    <div class="cancel-note admin-note">
                                        <strong>Ghi chú từ admin</strong>
                                        <p>@req.AdminNote</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (!Model.CancellationRequests.Any(r => r.Status == "Pending") && (Model.Status == "Chờ xác nhận" || Model.Status == "Đã xác nhận" || Model.Status == "Đang giao"))
                {
                    <div class="order-info-note">
                        <i class="bi bi-info-circle"></i>
                        <span>Bạn có thể yêu cầu hủy khi đơn ở trạng thái chờ xác nhận, đã xác nhận hoặc đang giao.</span>
                    </div>
                    <button type="button" onclick="openCancellationModal()" class="cancel-action">
                        <i class="bi bi-x-circle"></i>
                        Gửi yêu cầu hủy đơn
                    </button>
                }
                else if (!Model.CancellationRequests.Any(r => r.Status == "Pending"))
                {
                    <div class="order-info-note danger">
                        <i class="bi bi-lock"></i>
                        <span>Không thể hủy đơn ở trạng thái hiện tại: <strong>@Model.Status</strong></span>
                    </div>
                }
                else
                {
                    <div class="order-info-note warning">
                        <i class="bi bi-hourglass-split"></i>
                        <span>Bạn đã gửi yêu cầu hủy đơn. Vui lòng chờ phản hồi từ admin.</span>
                    </div>
                }
            </article>
        }
    </div>
</section>

<div class="modal-overlay" id="cancellation-modal-overlay">
    <div class="custom-modal order-cancel-modal">
        <button class="modal-close-btn" type="button" onclick="closeCancellationModal()" aria-label="Đóng">
            <i class="bi bi-x-lg"></i>
        </button>
        <h3 class="modal-title">Gửi yêu cầu hủy đơn</h3>
        <form id="cancellation-form" method="post" asp-controller="Orders" asp-action="RequestCancellation" asp-route-id="@Model.OrderId">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="cancellation-reason">Lý do hủy đơn</label>
                <textarea id="cancellation-reason" name="reason" class="form-control" placeholder="Vui lòng cho biết lý do hủy đơn hàng..." rows="5" required minlength="10" maxlength="500"></textarea>
                <small>Tối thiểu 10 ký tự, tối đa 500 ký tự</small>
            </div>
            <div class="modal-actions">
                <button type="button" onclick="closeCancellationModal()" class="soft-action">Hủy</button>
                <button type="submit" class="primary-action">Gửi yêu cầu</button>
            </div>
        </form>
    </div>
</div>

<style>
    .order-detail-page { padding: 9rem 8% 6rem; background: linear-gradient(180deg, #fbfaf4 0%, var(--bg-page) 100%); }
    .order-detail-shell { max-width: 1080px; margin: 0 auto; }
    .order-detail-hero { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.5rem; }
    .order-eyebrow { display: inline-flex; margin-bottom: 0.7rem; color: var(--accent-green); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
    .order-detail-hero h1 { max-width: 720px; margin: 0 0 0.9rem; color: var(--text-dark); font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 3.1rem); line-height: 1.08; }
    .order-meta-line { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; color: var(--text-muted); font-size: 0.95rem; }
    .order-code { display: inline-flex; max-width: min(100%, 560px); padding: 0.42rem 0.65rem; overflow-wrap: anywhere; border: 1px solid rgba(17, 60, 43, 0.12); border-radius: 5px; color: var(--accent-green); background: rgba(255, 255, 255, 0.72); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.86rem; font-weight: 800; }
    .order-back-link { display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem; min-height: 46px; padding: 0.75rem 1.1rem; border-radius: 5px; color: var(--bg-white); background: var(--accent-green); font-weight: 800; text-decoration: none; box-shadow: 0 14px 28px rgba(17, 60, 43, 0.16); transition: var(--transition-smooth); white-space: nowrap; }
    .order-back-link:hover { color: var(--bg-white); background: var(--accent-green-hover); transform: translateY(-2px); }
    .order-alert { display: flex; align-items: center; gap: 0.65rem; padding: 0.95rem 1rem; border-radius: 5px; margin-bottom: 1rem; font-weight: 700; }
    .order-alert.success { background: rgba(17, 60, 43, 0.09); color: var(--accent-green); border: 1px solid rgba(17, 60, 43, 0.15); }
    .order-alert.error { background: rgba(217, 56, 58, 0.1); color: #b42318; border: 1px solid rgba(217, 56, 58, 0.18); }
    .order-tracker { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; margin: 1.5rem 0; padding: 1.7rem 1.8rem 1.45rem; border: 1px solid rgba(17, 60, 43, 0.1); border-radius: 8px; background: rgba(255, 255, 255, 0.84); box-shadow: 0 18px 45px rgba(17, 60, 43, 0.08); overflow: hidden; }
    .tracker-rail, .tracker-progress { position: absolute; top: 3.05rem; left: calc(10% + 1.8rem); right: calc(10% + 1.8rem); height: 4px; border-radius: 999px; background: #dde8df; }
    .tracker-progress { right: auto; width: var(--progress-width); background: var(--accent-green); }
    .tracker-step { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 0.7rem; text-align: center; }
    .tracker-icon { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 3px solid #dde8df; border-radius: 50%; color: #718277; background: #fff; font-size: 1.25rem; }
    .tracker-label { color: var(--text-muted); font-size: 0.88rem; font-weight: 800; line-height: 1.35; }
    .tracker-step.active .tracker-icon { border-color: var(--accent-green); color: #fff; background: var(--accent-green); }
    .tracker-step.current .tracker-icon { border-color: var(--accent-green); color: var(--accent-green); background: #fff; box-shadow: 0 0 0 7px rgba(17, 60, 43, 0.11); }
    .tracker-step.active .tracker-label, .tracker-step.current .tracker-label { color: var(--accent-green); }
    .order-tracker.cancelled { display: block; }
    .tracker-cancelled-state { display: flex; align-items: center; justify-content: center; gap: 1rem; color: #b42318; text-align: left; }
    .tracker-cancelled-state .tracker-icon { border-color: #b42318; color: #fff; background: #b42318; }
    .tracker-cancelled-state strong, .tracker-cancelled-state small { display: block; }
    .tracker-cancelled-state small { margin-top: 0.2rem; color: var(--text-muted); }
    .receipt-callout { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; padding: 1.2rem; border: 1px dashed rgba(17, 60, 43, 0.45); border-radius: 8px; background: rgba(17, 60, 43, 0.06); }
    .receipt-callout h2 { margin: 0 0 0.35rem; color: var(--accent-green); font-size: 1.25rem; }
    .receipt-callout p { margin: 0; color: var(--text-muted); }
    .receipt-button { min-height: 46px; padding: 0.8rem 1.4rem; white-space: nowrap; }
    .order-card { border: 1px solid rgba(17, 60, 43, 0.1); border-radius: 8px; background: rgba(255, 255, 255, 0.86); box-shadow: 0 18px 42px rgba(17, 60, 43, 0.07); overflow: hidden; }
    .order-card + .order-card { margin-top: 1.25rem; }
    .product-card-detail { margin-top: 1.25rem; }
    .order-summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 1.25rem; margin-bottom: 1.25rem; align-items: stretch; }
    .order-summary-grid > .order-card { display: flex; flex-direction: column; height: 100%; margin-top: 0; }
    .order-card-head { display: flex; align-items: flex-start; gap: 0.85rem; padding: 1.2rem 1.25rem; border-bottom: 1px solid rgba(17, 60, 43, 0.09); }
    .card-icon { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 5px; color: var(--accent-green); background: rgba(17, 60, 43, 0.08); flex: 0 0 auto; }
    .card-icon.danger { color: #b42318; background: rgba(217, 56, 58, 0.1); }
    .order-card-head h2 { margin: 0; color: var(--text-dark); font-size: 1.12rem; line-height: 1.25; }
    .order-card-head p { margin: 0.25rem 0 0; color: var(--text-muted); font-size: 0.86rem; }
    .detail-list { display: grid; gap: 0.05rem; padding: 0.55rem 1.25rem 1.2rem; }
    .order-summary-grid .detail-list { flex: 1; align-content: start; }
    .detail-row { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 1rem; align-items: start; padding: 0.85rem 0; border-bottom: 1px solid rgba(17, 60, 43, 0.08); }
    .detail-row:last-child { border-bottom: 0; }
    .detail-row span { color: var(--text-muted); font-size: 0.9rem; }
    .detail-row strong { color: var(--text-dark); text-align: left; overflow-wrap: anywhere; }
    .total-card .detail-row { grid-template-columns: minmax(130px, 1fr) auto; }
    .total-card .detail-row strong { text-align: right; white-space: nowrap; }
    .order-status-pill { justify-self: start; display: inline-flex; align-items: center; padding: 0.42rem 0.65rem; border-radius: 5px; font-size: 0.78rem; }
    .order-status-pill.approved { color: var(--accent-green); background: rgba(17, 60, 43, 0.09); }
    .order-status-pill.pending { color: #9a5d00; background: rgba(236, 163, 67, 0.18); }
    .order-status-pill.cancelled { color: #b42318; background: rgba(217, 56, 58, 0.12); }
    .discount-row strong, .grand-total-row strong { color: var(--accent-green); }
    .grand-total-row { margin-top: 0.35rem; padding-top: 1rem; border-top: 1px solid rgba(17, 60, 43, 0.14); border-bottom: 0; }
    .grand-total-row strong { font-size: 1.45rem; }
    .cancellation-panel { margin-top: 1.25rem; }
    .cancel-history { padding: 1rem 1.25rem 0; }
    .cancel-history h3 { margin: 0 0 0.8rem; color: var(--text-dark); font-size: 1rem; }
    .cancel-request { padding: 1rem; border: 1px solid rgba(17, 60, 43, 0.09); border-left: 4px solid #e3a33d; border-radius: 5px; background: #fff; }
    .cancel-request + .cancel-request { margin-top: 0.8rem; }
    .cancel-request.approved { border-left-color: var(--accent-green); }
    .cancel-request.rejected { border-left-color: #b42318; }
    .cancel-request-top { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; margin-bottom: 0.85rem; }
    .cancel-request-top span { font-weight: 800; }
    .cancel-request-top small { color: var(--text-muted); white-space: nowrap; }
    .cancel-note { padding: 0.8rem; border-radius: 5px; background: var(--bg-card); }
    .cancel-note + .cancel-note { margin-top: 0.7rem; }
    .cancel-note strong, .cancel-note p { display: block; margin: 0; }
    .cancel-note p { margin-top: 0.3rem; color: var(--text-muted); }
    .order-info-note { display: flex; align-items: flex-start; gap: 0.65rem; margin: 1rem 1.25rem; padding: 0.9rem; border-radius: 5px; color: var(--accent-green); background: rgba(17, 60, 43, 0.07); }
    .order-info-note.danger { color: #b42318; background: rgba(217, 56, 58, 0.09); }
    .order-info-note.warning { color: #9a5d00; background: rgba(236, 163, 67, 0.15); }
    .cancel-action { display: flex; align-items: center; justify-content: center; gap: 0.5rem; width: calc(100% - 2.5rem); min-height: 46px; margin: 0 1.25rem 1.25rem; border: 1px solid rgba(217, 56, 58, 0.28); border-radius: 5px; color: #b42318; background: rgba(217, 56, 58, 0.09); font-weight: 800; cursor: pointer; }
    .cancel-action:hover { color: #fff; background: #b42318; }
    .order-products-wrap { overflow-x: auto; }
    .order-products-table { width: 100%; min-width: 680px; border-collapse: collapse; }
    .order-products-table th, .order-products-table td { padding: 1rem 1.25rem; border-bottom: 1px solid rgba(17, 60, 43, 0.09); text-align: right; vertical-align: middle; }
    .order-products-table th:first-child, .order-products-table td:first-child { text-align: left; }
    .order-products-table th { color: var(--text-muted); background: rgba(17, 60, 43, 0.04); font-size: 0.76rem; font-weight: 900; text-transform: uppercase; }
    .order-products-table tbody tr:last-child td { border-bottom: 0; }

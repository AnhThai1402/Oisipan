@model FrontendMvc.Models.NewsArticleViewModel

@{
    ViewData["Title"] = "Sửa bài viết";
}

<div class="admin-form admin-form-wide">
    <h1>Sửa bài viết</h1>
    <form asp-action="Edit"
          asp-route-id="@Model.NewsArticleId"
          method="post"
          enctype="multipart/form-data"
          novalidate>
        <input asp-for="NewsArticleId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <partial name="_NewsForm" model="Model" />
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

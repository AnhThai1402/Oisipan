@model FrontendMvc.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
    var checkoutItems = ViewBag.CheckoutItems as List<FrontendMvc.Models.CartItemViewModel> ?? new List<FrontendMvc.Models.CartItemViewModel>();
    var totalAmount = checkoutItems.Sum(x => x.LineTotal);
    var totalQuantity = checkoutItems.Sum(x => x.Quantity);
    var buyNowVariantId = ViewBag.BuyNowVariantId as Guid?;
    var userAddresses = ViewBag.UserAddresses as List<FrontendMvc.Models.UserAddressViewModel> ?? new List<FrontendMvc.Models.UserAddressViewModel>();
}

@section Styles {
    <style>
        .checkout-page {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .checkout-section {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 1px 10px rgba(0,0,0,0.05);
            margin-bottom: 1rem;
            overflow: hidden;
        }

        /* Address Section */
        .address-stripe {
            height: 3px;
            width: 100%;
            background-image: repeating-linear-gradient(45deg, #ff4c4c 0, #ff4c4c 33px, transparent 0, transparent 41px, #5cb85c 0, #5cb85c 74px, transparent 0, transparent 82px);
            /* Used Oishipan's green instead of blue for the stripe to match branding */
        }
        
        .address-content {
            padding: 1.5rem;
        }

        .address-header {
            color: var(--accent-green);
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .address-details {
            display: flex;
            align-items: baseline;
            gap: 1rem;
            font-size: 1rem;
        }

        .address-name-phone {
            font-weight: 700;
            color: var(--text-dark);
            min-width: max-content;
        }

        .address-text {
            color: var(--text-muted);
            flex: 1;
        }

        .default-badge {
            font-size: 0.75rem;
            color: var(--accent-red);
            border: 1px solid var(--accent-red);
            padding: 0.1rem 0.4rem;
            border-radius: 3px;
            margin-left: 0.5rem;
        }

        .change-btn {
            color: var(--accent-green);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            background: none;
            border: none;
        }

        /* Products Section */
        .products-table-wrap {
            padding: 1.5rem;
        }

        .products-header {
            display: grid;
            grid-template-columns: 4fr 1fr 1fr 1fr;
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .product-row {
            display: grid;
            grid-template-columns: 4fr 1fr 1fr 1fr;
            align-items: center;
            padding: 1rem 0;
            border-top: 1px dashed var(--border-color);
        }

        .product-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .product-img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 4px;
            border: 1px solid var(--border-color);
        }

        .product-name {
            font-weight: 500;
            color: var(--text-dark);
        }
        
        .product-variant {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* Voucher Section */
        .voucher-section, .shipping-section {
            padding: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px dashed var(--border-color);
        }

        .voucher-input-group {
            display: flex;
            gap: 1rem;
            align-items: center;
        }
        
        .voucher-input {
            border: 1px solid var(--border-color);
            padding: 0.5rem 1rem;
            border-radius: 4px;
            text-transform: uppercase;
        }

        /* Note & Shipping */
        .message-shipping-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            padding: 1.5rem;
            background: #fdfdfd;
        }

        .message-box {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .message-input {
            flex: 1;
            padding: 0.6rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: 4px;
        }

        .shipping-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .shipping-fee {
            font-weight: 600;
        }

        /* Payment Methods */
        .payment-methods-section {
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 2rem;
            border-bottom: 1px dashed var(--border-color);
        }

        .payment-options-row {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .pay-option-btn {
            border: 1px solid var(--border-color);
            background: white;
            padding: 0.5rem 1.5rem;
            border-radius: 4px;
            cursor: pointer;
            transition: 0.2s;
        }

        .pay-option-btn.active {
            border-color: var(--accent-green);
            color: var(--accent-green);
            position: relative;
        }

        .pay-option-btn.active::after {
            content: '✓';
            position: absolute;
            bottom: -1px;
            right: -1px;
            background: var(--accent-green);
            color: white;
            font-size: 0.6rem;
            width: 14px;
            height: 14px;
            border-radius: 50% 0 0 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-left: 2px;
            padding-top: 2px;
        }

        /* Summary Section */
        .summary-section {
            padding: 1.5rem;
            background: #fffafa;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 1rem;
        }

        .summary-row {
            display: flex;
            justify-content: flex-end;
            gap: 2rem;
            width: 300px;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .summary-val {
            font-weight: 500;
            color: var(--text-dark);
        }

        .summary-total {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 1rem;
            padding-top: 1rem;
            border-top: 1px dashed var(--border-color);
            width: 100%;
        }

        .total-label {
            font-size: 1rem;
            color: var(--text-dark);
        }

        .total-amount {
            font-size: 1.5rem;
            color: var(--accent-red);
            font-weight: 600;
        }

        .place-order-btn {
            background: var(--accent-green);
            color: white;
            border: none;
            padding: 0.8rem 3rem;
            font-size: 1.1rem;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.3s;
        }
        
        .place-order-btn:hover {
            background: #113c2b; /* dark green */
        }

        .text-right {
            text-align: right;
        }
        
        .text-center {
            text-align: center;
        }

        /* Quantity Controls */
        .cart-qty-controls {
            display: inline-flex;
            align-items: center;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            overflow: hidden;
            background: var(--bg-white);
        }
        .cart-qty-controls button {
            background: none;
            border: none;
            padding: 0.3rem 0.6rem;
            cursor: pointer;
            color: var(--text-dark);
            transition: var(--transition-smooth);
        }
        .cart-qty-controls button:hover {
            background: var(--bg-card);
            color: var(--accent-green);
        }
        .cart-qty-display {
            padding: 0 0.5rem;
            font-size: 0.9rem;
            font-weight: 500;
            min-width: 25px;
            text-align: center;
        }

        /* Modal Styles */
        .address-modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: 0.3s;
        }
        .address-modal-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }
        .address-modal {
            background: white;
            width: 500px;
            max-width: 90%;
            border-radius: 8px;
            padding: 2rem;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
        }
        .address-item {
            border: 1px solid var(--border-color);
            padding: 1rem;
            border-radius: 4px;
            margin-bottom: 1rem;
            cursor: pointer;
            transition: 0.2s;
        }
        .address-item:hover {
            border-color: var(--accent-green);
        }
        .address-item.selected {
            border-color: var(--accent-green);
            background: #f0faf5;
        }
    </style>
}

<div class="checkout-page">
    <form id="checkout-page-form" method="post" asp-controller="Cart" asp-action="Checkout">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.Path" />
        <input type="hidden" name="BuyNowProductId" value="@buyNowVariantId" />
        <input type="hidden" id="PaymentMethod" name="PaymentMethod" value="COD" />

        <!-- Address Section -->
        <div class="checkout-section">
            <div class="address-stripe"></div>
            <div class="address-content">
                <div class="address-header">
                    <i class="bi bi-geo-alt-fill"></i> Địa Chỉ Nhận Hàng
                </div>
                <div class="address-details" id="display-address">
                    <div class="address-name-phone">
                        <span id="display-name">@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "Chưa có tên" : Model.CustomerName)</span> 
                        (<span id="display-phone">@(string.IsNullOrWhiteSpace(Model.CustomerPhone) ? "Chưa có SĐT" : Model.CustomerPhone)</span>)
                    </div>
                    <div class="address-text" id="display-full-address">
                        @(string.IsNullOrWhiteSpace(Model.CustomerAddress) ? "Vui lòng nhập địa chỉ nhận hàng" : Model.CustomerAddress)
                        <span class="default-badge">Mặc Định</span>
                    </div>
                    <button type="button" class="change-btn" id="open-address-modal-btn">Thay Đổi</button>
                </div>

                <!-- Hidden inputs for form submission -->
                <input type="hidden" id="CustomerName" name="CustomerName" value="@Model.CustomerName" required />
                <input type="hidden" id="CustomerPhone" name="CustomerPhone" value="@Model.CustomerPhone" required />
                <input type="hidden" id="CustomerAddress" name="CustomerAddress" value="@Model.CustomerAddress" required />
            </div>
        </div>

        <!-- Products Section -->
        <div class="checkout-section">
            <div class="products-table-wrap">
                <h3 style="margin-bottom: 1.5rem; font-size: 1.1rem;">Sản phẩm</h3>
                <div class="products-header">
                    <div></div>
                    <div class="text-center">Đơn giá</div>
                    <div class="text-center">Số lượng</div>
                    <div class="text-right">Thành tiền</div>
                </div>

                @foreach(var item in checkoutItems)
                {
                    <div class="product-row">
                        <div class="product-info">
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="@item.Image" alt="@item.ProductName" class="product-img" />
                            }
                            else
                            {
                                <div class="product-img" style="display:flex;align-items:center;justify-content:center;background:#f0f0f0;">
                                    <i class="bi bi-image" style="color:#aaa;"></i>
                                </div>
                            }
                            <div>
                                <div class="product-name">@item.ProductName</div>
                                @if(!string.IsNullOrEmpty(item.ProductName))
                                {
                                    <div class="product-variant">Phân loại: @item.ProductName</div>
                                }
                            </div>
                        </div>
                        <div class="text-center text-muted">@item.UnitPrice.ToString("N0")đ</div>
                        <div class="text-center">
                            <div class="cart-qty-controls" style="justify-content:center;">
                                <button type="button" class="checkout-qty-btn cart-qty-decrease" data-product-variant-id="@item.ProductId" data-quantity="@(item.Quantity - 1)"><i class="bi bi-dash"></i></button>
                                <span class="cart-qty-display">@item.Quantity</span>
                                <button type="button" class="checkout-qty-btn cart-qty-increase" data-product-variant-id="@item.ProductId" data-quantity="@(item.Quantity + 1)"><i class="bi bi-plus"></i></button>
                            </div>
                        </div>
                        <div class="text-right text-dark" style="font-weight:500;">@item.LineTotal.ToString("N0")đ</div>
                    </div>
                }
            </div>

            <!-- Message & Shipping -->
            <div class="message-shipping-grid">
                <div class="message-box">
                    <label style="white-space: nowrap;">Lời nhắn:</label>
                    <input type="text" class="message-input" placeholder="Lưu ý cho Người bán..." />
                </div>
                <div class="shipping-info">
                    <div class="text-muted">Phương thức vận chuyển</div>
                    <div class="shipping-fee text-dark" id="shipping-fee-status">Đang tính phí...</div>
                </div>
            </div>
        </div>

        <!-- Voucher Section -->
        <div class="checkout-section">
            <div class="voucher-section" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.1rem;">
                    <i class="bi bi-ticket-perforated" style="color: var(--accent-red);"></i> Voucher Oishipan
                </div>
                <div class="voucher-action" style="display: flex; align-items: center;">
                    <input type="hidden" id="VoucherCode" name="VoucherCode" value="@Model.VoucherCode" />
                    <span id="selected-voucher-display" style="margin-right: 1rem; font-weight: 500; color: var(--accent-red); display: none;"></span>
                    <button type="button" id="open-voucher-modal-btn" class="change-btn" style="white-space: nowrap;">Chọn Voucher</button>
                </div>
            </div>
            <div style="width: 100%; text-align: right; margin-top: 5px;">
                <span id="page-voucher-message" style="display:none; font-size: 0.85rem; font-weight: 500;"></span>
            </div>
        </div>

        <!-- Summary Section -->
        <div class="checkout-section">
            <div class="payment-methods-section">
                <div style="font-size: 1.1rem;">Phương thức thanh toán</div>
                <div class="payment-options-row">
                    <button type="button" class="pay-option-btn active" data-method="COD">Thanh toán khi nhận hàng</button>
                    <button type="button" class="pay-option-btn" data-method="VNPAY">VNPay</button>
                </div>
            </div>

            <div class="summary-section">
                <div class="summary-row">
                    <span>Tổng tiền hàng</span>
                    <span class="summary-val">@totalAmount.ToString("N0")đ</span>
                </div>
                <div class="summary-row" id="discount-row" style="display: none;">
                    <span>Giảm giá Voucher</span>
                    <span class="summary-val" style="color: var(--accent-red);" id="discount-amount">-0đ</span>
                </div>
                <div class="summary-row">
                    <span>Phí vận chuyển</span>
                    <span class="summary-val" id="shipping-fee-display">0đ</span>
                </div>
                <div class="summary-row" style="display: none;">
                    <span>Phụ phí (Túi giữ nhiệt > 5km)</span>
                    <span class="summary-val" id="surcharge-fee-display">0đ</span>
                </div>
                
                <div class="summary-total">
                    <span class="total-label">Tổng thanh toán:</span>
                    <span class="total-amount" id="final-total">@totalAmount.ToString("N0")đ</span>
                    <input type="hidden" id="base-amount" value="@totalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div style="width: 100%; display: flex; justify-content: flex-end; margin-top: 1rem;">
                    <button type="button" class="place-order-btn" id="submit-checkout-btn">Đặt Hàng</button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Voucher Selection Modal -->
<div class="address-modal-overlay" id="voucher-modal-overlay">
    <div class="address-modal" style="width: 500px; max-width: 90%; background: #fff; padding: 2rem; border-radius: 12px; position: relative;">
        <button type="button" class="close-cart" id="close-voucher-modal-btn" style="position:absolute; top: 1rem; right: 1rem;"><i class="bi bi-x-lg"></i></button>
        <h3 style="margin-bottom: 1.5rem; color: var(--accent-green);">Chọn Voucher Oishipan</h3>
        
        <div style="max-height: 50vh; overflow-y: auto; padding-right: 10px;">
            @if (ViewBag.UserVouchers != null && ViewBag.UserVouchers.Count > 0)
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var v in ViewBag.UserVouchers)
                    {
                        var isUsable = v.IsUsed == false && (v.ExpiryDate >= DateTime.Now) && (v.MinOrderValue <= totalAmount);
                        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1rem; display: flex; justify-content: space-between; align-items: center; @(isUsable ? "" : "opacity: 0.6;")">
                            <div>
                                <h4 style="margin: 0 0 5px 0; color: var(--accent-red);">@v.VoucherCode</h4>
                                <div style="font-size: 0.9rem; color: #333;">
                                    Giảm @(v.DiscountType == "Percentage" ? $"{v.DiscountValue}%" : $"{v.DiscountValue:N0}đ")
                                </div>
                                @if (v.MinOrderValue > 0)
                                {
                                    <div style="font-size: 0.8rem; color: #666;">Đơn tối thiểu: @v.MinOrderValue.ToString("N0")đ</div>
                                }
                                @if (v.ExpiryDate.Year < 9999)
                                {
                                    <div style="font-size: 0.8rem; color: #666;">HSD: @v.ExpiryDate.ToString("dd/MM/yyyy")</div>
                                }
                            </div>
                            <div>
                                @if (isUsable)
                                {
                                    <button type="button" class="place-order-btn select-voucher-btn" data-code="@v.VoucherCode" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Áp dụng</button>
                                }
                                else
                                {
                                    <button type="button" style="padding: 0.5rem 1rem; font-size: 0.9rem; background: #ccc; color: #fff; border: none; border-radius: 4px; cursor: not-allowed;" disabled>Chưa đủ ĐK</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 2rem 0; color: #888;">
                    Bạn chưa có voucher nào trong ví.
                </div>
            }
        </div>
    </div>
</div>


<!-- Address Selection Modal -->
<div class="address-modal-overlay" id="address-modal">
    <div class="address-modal">
        <button type="button" class="close-cart" style="position:absolute; top: 1rem; right: 1rem;" onclick="closeAddressModal()"><i class="bi bi-x-lg"></i></button>
        
        <div id="address-list-view">
            <h3 style="margin-bottom: 1.5rem; color: var(--accent-green);">Chọn Địa Chỉ Nhận Hàng</h3>
            <div id="address-list-container">
                @foreach (var addr in userAddresses)
                {
                    <div class="address-item" onclick="selectAddress('@addr.RecipientName', '@addr.PhoneNumber', '@Html.Raw(addr.FullAddress)')">
                        <div style="font-weight:600; margin-bottom: 0.3rem;">@addr.RecipientName (@addr.PhoneNumber) @(addr.IsDefault ? Html.Raw("<span class='default-badge' style='margin-left:0.5rem; font-size:0.75rem; background:var(--accent-red); color:white; padding:0.1rem 0.4rem; border-radius:3px;'>Mặc định</span>") : "")</div>
                        <div style="color:var(--text-muted); font-size:0.9rem;">@addr.FullAddress</div>
                    </div>
                }
            </div>
            
            <button type="button" class="btn-outline" style="width:100%; padding:0.8rem; border-radius:4px; border:1px dashed var(--accent-green); color:var(--accent-green); background:transparent; cursor:pointer;" onclick="showAddAddressForm()">
                <i class="bi bi-plus-circle"></i> Thêm Địa Chỉ Mới
            </button>
        </div>

        <div id="address-add-view" style="display:none;">
            <h3 style="margin-bottom: 1.5rem; color: var(--accent-green);"><i class="bi bi-arrow-left" style="cursor:pointer; margin-right: 0.5rem;" onclick="showAddressList()"></i> Thêm Địa Chỉ Mới</h3>
            <form id="add-address-form" method="post">
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label>Họ và Tên</label>
                    <input type="text" id="newRecipientName" name="RecipientName" class="form-control" required style="width:100%; padding:0.6rem; border:1px solid #ccc; border-radius:4px;" />
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label>Số điện thoại</label>
                    <input type="text" id="newPhoneNumber" name="PhoneNumber" class="form-control" required style="width:100%; padding:0.6rem; border:1px solid #ccc; border-radius:4px;" />
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                    <div class="form-group">
                        <label>Tỉnh/Thành phố</label>
                        <select id="newProvince" class="form-control" required style="width:100%; padding:0.6rem; border:1px solid #ccc; border-radius:4px;">
                            <option value="">Chọn Tỉnh/Thành phố</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Phường/Xã</label>
                        <select id="newWard" class="form-control" required disabled style="width:100%; padding:0.6rem; border:1px solid #ccc; border-radius:4px;">
                            <option value="">Chọn Phường/Xã</option>
                        </select>
                    </div>
                </div>
                
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label>Địa chỉ cụ thể (Số nhà, đường...)</label>
                    <input type="text" id="newDetail" class="form-control" required style="width:100%; padding:0.6rem; border:1px solid #ccc; border-radius:4px;" placeholder="Ví dụ: 123 Đường ABC..." />
                </div>
                
                <div style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                    <input type="checkbox" id="newIsDefault" name="IsDefault" value="true" />
                    <label for="newIsDefault" style="margin:0;">Đặt làm địa chỉ mặc định</label>
                </div>
                <button type="button" class="place-order-btn" style="width:100%;" onclick="submitNewAddress()">Lưu Địa Chỉ</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            // Payment and Submit Logic
            const payBtns = document.querySelectorAll('.pay-option-btn');
            const submitBtn = document.getElementById('submit-checkout-btn');
            payBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    payBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    document.getElementById('PaymentMethod').value = this.dataset.method;
                    if (submitBtn) {
                        submitBtn.textContent = this.dataset.method === 'VNPAY' ? 'Thanh toán VNPay' : 'Đặt Hàng';
                    }
                });
            });

            if (submitBtn) {
                submitBtn.addEventListener('click', function() {
                    const name = document.getElementById('CustomerName').value;
                    const phone = document.getElementById('CustomerPhone').value;
                    const addr = document.getElementById('CustomerAddress').value;

                    if (!name || !phone || !addr) {
                        document.getElementById('address-modal').classList.add('open');
                        if (typeof triggerToast === 'function') triggerToast('Vui lòng chọn hoặc thêm địa chỉ nhận hàng.', 'warning');
                        return;
                    }

                    document.getElementById('checkout-page-form').submit();
                });
            }

            // Voucher logic
            const openVoucherModalBtn = document.getElementById('open-voucher-modal-btn');
            const closeVoucherModalBtn = document.getElementById('close-voucher-modal-btn');
            const voucherModal = document.getElementById('voucher-modal-overlay');
            
            if (openVoucherModalBtn && voucherModal) {
                openVoucherModalBtn.addEventListener('click', () => {
                    voucherModal.classList.add('open');
                });
            }
            if (closeVoucherModalBtn && voucherModal) {
                closeVoucherModalBtn.addEventListener('click', () => {
                    voucherModal.classList.remove('open');
                });
            }
            
            const initialVoucher = document.getElementById('VoucherCode') ? document.getElementById('VoucherCode').value : null;
            if (initialVoucher) {
                applyVoucherCode(initialVoucher, true);
            }

            document.querySelectorAll('.select-voucher-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const code = this.dataset.code;
                    await applyVoucherCode(code, false);
                    if (voucherModal) voucherModal.classList.remove('open');
                });
            });

            async function applyVoucherCode(code, isInitial) {
                const msgEl = document.getElementById('page-voucher-message');
                const baseTotal = parseFloat(document.getElementById('base-amount').value);
                const discountRow = document.getElementById('discount-row');
                const discountAmountEl = document.getElementById('discount-amount');
                const finalTotalEl = document.getElementById('final-total');
                const selectedVoucherDisplay = document.getElementById('selected-voucher-display');
                const openModalBtn = document.getElementById('open-voucher-modal-btn');

                try {
                    const res = await fetch('/Cart/ValidateVoucher', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Code: code, OrderTotal: baseTotal, TotalItems: @(((List<FrontendMvc.Models.CartItemViewModel>)ViewBag.CheckoutItems).Sum(x => x.Quantity)) })
                    });
                    const data = await res.json();

                    if (!isInitial && msgEl) {
                        msgEl.style.display = 'inline-block';
                    }
                    if (data.isValid) {
                        if (!isInitial && msgEl) {
                            msgEl.style.color = 'var(--accent-green)';
                            msgEl.textContent = 'Áp dụng thành công!';
                        }
                        const vCodeEl = document.getElementById('VoucherCode');
                        if(vCodeEl) vCodeEl.value = code;
                        
                        let discount = data.discountAmount || 0;
                        
                        let currentShippingStr = document.getElementById('shipping-fee-display')?.textContent.replace(/[^0-9]/g, '') || '0';
                        let currentSurchargeStr = document.getElementById('surcharge-fee-display')?.textContent.replace(/[^0-9]/g, '') || '0';
                        let currentShipping = parseFloat(currentShippingStr) || 0;
                        let currentSurcharge = parseFloat(currentSurchargeStr) || 0;

                        const finalTotal = baseTotal + currentShipping + currentSurcharge - discount;

                        if (selectedVoucherDisplay) {
                            selectedVoucherDisplay.style.display = 'inline';
                            selectedVoucherDisplay.textContent = 'Mã: ' + code + ' (-' + discount.toLocaleString('vi-VN') + 'đ)';
                        }
                        if (openModalBtn) {
                            openModalBtn.textContent = 'Đổi Voucher';
                        }
                        
                        if(discountRow) discountRow.style.display = 'flex';
                        if(discountAmountEl) discountAmountEl.textContent = '-' + discount.toLocaleString('vi-VN') + 'đ';
                        if(finalTotalEl) finalTotalEl.textContent = finalTotal.toLocaleString('vi-VN') + 'đ';
                        
                        if (!isInitial && typeof triggerToast === 'function') triggerToast('Áp dụng voucher thành công!', 'success');
                    } else {
                        if (!isInitial && msgEl) {
                            msgEl.style.color = 'var(--accent-red)';
                            msgEl.textContent = data.message || 'Mã không hợp lệ';
                        }
                        const vCodeEl = document.getElementById('VoucherCode');
                        if(vCodeEl) vCodeEl.value = '';
                        
                        if (selectedVoucherDisplay) {
                            selectedVoucherDisplay.style.display = 'none';
                        }
                        if (openModalBtn) {
                            openModalBtn.textContent = 'Chọn Voucher';
                        }
                        if(discountRow) discountRow.style.display = 'none';

                        let currentShippingStr = document.getElementById('shipping-fee-display')?.textContent.replace(/[^0-9]/g, '') || '0';
                        let currentSurchargeStr = document.getElementById('surcharge-fee-display')?.textContent.replace(/[^0-9]/g, '') || '0';
                        let currentShipping = parseFloat(currentShippingStr) || 0;
                        let currentSurcharge = parseFloat(currentSurchargeStr) || 0;
                        const finalTotal = baseTotal + currentShipping + currentSurcharge;

                        if(finalTotalEl) finalTotalEl.textContent = finalTotal.toLocaleString('vi-VN') + 'đ';
                        
                        if (!isInitial && typeof triggerToast === 'function') triggerToast(data.message || 'Voucher không hợp lệ', 'error');
                    }
                } catch (e) {
                    console.error(e);
                }
            }
        })();

        async function calculateShipping(address) {
            if (!address) return;
            const checkoutBtn = document.getElementById('submit-checkout-btn');
            try {
                if (checkoutBtn) checkoutBtn.disabled = true;
                
                const response = await fetch('/Cart/CalculateShipping', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Address: address })
                });

                let result;
                try {
                    result = await response.json();
                } catch(err) {
                    throw new Error("Server returned an invalid response (not JSON). Please restart the application.");
                }
                
                // Cập nhật giao diện
                let shippingDisplay = document.getElementById('shipping-fee-display');
                let surchargeDisplay = document.getElementById('surcharge-fee-display');
                let finalTotalEl = document.getElementById('final-total');
                let shippingStatusDisplay = document.getElementById('shipping-fee-status');
                let baseAmount = parseFloat(document.getElementById('base-amount').value || 0);
                let discountAmountStr = document.getElementById('discount-amount')?.textContent.replace(/[^0-9]/g, '') || '0';
                let discountAmount = parseFloat(discountAmountStr) || 0;

                if (!response.ok || result.isValid === false) {
                    if (typeof triggerToast === 'function') triggerToast(result.message || 'Lỗi tính phí giao hàng', 'error');
                    if (shippingDisplay) shippingDisplay.textContent = 'Không hỗ trợ';
                    if (shippingStatusDisplay) shippingStatusDisplay.textContent = 'Không hỗ trợ giao hàng';
                    if (surchargeDisplay) surchargeDisplay.parentElement.style.display = 'none';
                    if (checkoutBtn) checkoutBtn.disabled = true;
                } else {
                    let feeText = result.shippingFee > 0 ? (result.shippingFee.toLocaleString('vi-VN') + 'đ') : 'Miễn phí giao hàng';
                    if (shippingDisplay) shippingDisplay.textContent = result.shippingFee.toLocaleString('vi-VN') + 'đ';
                    if (shippingStatusDisplay) shippingStatusDisplay.textContent = feeText;
                    
                    if (surchargeDisplay && result.surchargeFee > 0) {
                        surchargeDisplay.parentElement.style.display = 'flex';
                        surchargeDisplay.textContent = result.surchargeFee.toLocaleString('vi-VN') + 'đ';
                    } else if (surchargeDisplay) {
                        surchargeDisplay.parentElement.style.display = 'none';
                    }

                    let newTotal = baseAmount + result.shippingFee + (result.surchargeFee || 0) - discountAmount;
                    if (finalTotalEl) finalTotalEl.textContent = newTotal.toLocaleString('vi-VN') + 'đ';

                    if (checkoutBtn) checkoutBtn.disabled = false;
                }
            } catch (error) {
                console.error(error);
                if (typeof triggerToast === 'function') triggerToast('Lỗi khi tính phí vận chuyển.', 'error');
            }
        }
        
        // Gọi tính phí ban đầu nếu có sẵn địa chỉ
        const initialAddress = document.getElementById('CustomerAddress')?.value;
        if (initialAddress) {
            calculateShipping(initialAddress);
        }
        
        // Quantity update handling
        document.querySelectorAll('.checkout-qty-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.preventDefault();
                const productVariantId = btn.dataset.productVariantId;
                const quantity = parseInt(btn.dataset.quantity);
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                if (quantity <= 0) return; // Optional: handle remove later or reload

                try {
                    btn.disabled = true;
                    const response = await fetch('/Cart/Update', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: new URLSearchParams({
                            productVariantId: productVariantId,
                            quantity: quantity,
                            __RequestVerificationToken: token
                        })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        if (data.message && quantity > parseInt(btn.parentElement.querySelector('.cart-qty-display').innerText)) {
                            // Hit limit
                            triggerToast(data.message, 'warning');
                            btn.disabled = false;
                        } else {
                            // Reload to recalculate everything
                            window.location.reload();
                        }
                    }
                } catch (e) {
                    btn.disabled = false;
                    console.error(e);
                }
            });
        });

        // Address Modal Handling
        const addressModal = document.getElementById('address-modal');
        document.getElementById('open-address-modal-btn').addEventListener('click', () => {
            addressModal.classList.add('open');
            showAddressList();
        });

        function closeAddressModal() {
            addressModal.classList.remove('open');
        }

        async function initNewProvinces() {
            const pSelect = document.getElementById('newProvince');
            if (pSelect.options.length <= 1) {
                try {
                    const data = await fetchAllProvinces();
                    if(data) {
                        data.forEach(p => {
                            const opt = document.createElement('option');
                            opt.value = p.code; opt.textContent = p.name;
                            pSelect.appendChild(opt);
                        });
                    }
                } catch(e) {}
            }
        }

        document.getElementById('newProvince').addEventListener('change', async function() {
            const wSelect = document.getElementById('newWard');
            wSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
            wSelect.disabled = true;
            const code = this.value;
            if(!code) return;

            try {
                const wards = await fetchProvinceWards(code);
                if(wards) {
                    wards.forEach(w => {
                        const opt = document.createElement('option');
                        opt.value = w.code; opt.textContent = w.name;
                        wSelect.appendChild(opt);
                    });
                    wSelect.disabled = false;
                }
            } catch(e) {}
        });

        function showAddAddressForm() {
            document.getElementById('address-list-view').style.display = 'none';
            document.getElementById('address-add-view').style.display = 'block';
            initNewProvinces();
        }

        function showAddressList() {
            document.getElementById('address-list-view').style.display = 'block';
            document.getElementById('address-add-view').style.display = 'none';
        }

        async function selectAddress(name, phone, address) {
            document.getElementById('CustomerName').value = name;
            document.getElementById('CustomerPhone').value = phone;
            document.getElementById('CustomerAddress').value = address;
            
            document.getElementById('display-name').textContent = name;
            document.getElementById('display-phone').textContent = phone;
            document.getElementById('display-full-address').innerHTML = address;
            
            closeAddressModal();

            await calculateShipping(address);
        }

        async function submitNewAddress() {
            const form = document.getElementById('add-address-form');
            if(!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Build full address
            const prov = document.getElementById('newProvince');
            const ward = document.getElementById('newWard');
            const detail = document.getElementById('newDetail').value;
            let fullAddr = "";
            if (prov.value && ward.value) {
                fullAddr = detail ? `${detail}, ${ward.options[ward.selectedIndex].text}, ${prov.options[prov.selectedIndex].text}` 
                                  : `${ward.options[ward.selectedIndex].text}, ${prov.options[prov.selectedIndex].text}`;
            } else {
                fullAddr = detail;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            const params = new URLSearchParams();
            params.append('RecipientName', document.getElementById('newRecipientName').value);
            params.append('PhoneNumber', document.getElementById('newPhoneNumber').value);
            params.append('FullAddress', fullAddr);
            params.append('IsDefault', document.getElementById('newIsDefault').checked ? 'true' : 'false');
            params.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('/Cart/AddAddressAjax', {
                    method: 'POST',
                    body: params,
                    headers: { 
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                });
                
                const text = await response.text();
                let result;
                try {
                    result = JSON.parse(text);
                } catch (jsonErr) {
                    console.error("Non-JSON Response received:", text);
                    triggerToast('Lỗi hệ thống: Server không trả về JSON. Kiểm tra F12 Console.', 'error');
                    return;
                }
                
                if(result.success) {
                    const data = result.data;
                    selectAddress(data.recipientName, data.phoneNumber, data.fullAddress);
                    
                    const container = document.getElementById('address-list-container');
                    const newItem = document.createElement('div');
                    newItem.className = 'address-item';
                    newItem.onclick = () => selectAddress(data.recipientName, data.phoneNumber, data.fullAddress);
                    newItem.innerHTML = `<div style="font-weight:600; margin-bottom: 0.3rem;">${data.recipientName} (${data.phoneNumber})</div><div style="color:var(--text-muted); font-size:0.9rem;">${data.fullAddress}</div>`;
                    container.appendChild(newItem);
                    
                    triggerToast('Thêm địa chỉ thành công', 'success');
                    
                    // Reset form
                    form.reset();
                    document.getElementById('newWard').innerHTML = '<option value="">Chọn Phường/Xã</option>';
                    document.getElementById('newWard').disabled = true;
                } else {
                    triggerToast(result.message || 'Có lỗi xảy ra', 'error');
                }
            } catch(e) {
                console.error("Network or script error:", e);
                triggerToast('Lỗi kết nối hoặc thực thi script', 'error');
            }
        }
    </script>
}

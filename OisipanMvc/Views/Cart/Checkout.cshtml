@model FrontendMvc.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
    var checkoutItems = ViewBag.CheckoutItems as List<FrontendMvc.Models.CartItemViewModel> ?? new List<FrontendMvc.Models.CartItemViewModel>();
    var totalAmount = checkoutItems.Sum(x => x.LineTotal);
    var totalQuantity = checkoutItems.Sum(x => x.Quantity);
    var buyNowVariantId = ViewBag.BuyNowVariantId as Guid?;
}

@section Styles {
    <style>
        .checkout-page {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .checkout-section {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 1px 10px rgba(0,0,0,0.05);
            margin-bottom: 1rem;
            overflow: hidden;
        }

        /* Address Section */
        .address-stripe {
            height: 3px;
            width: 100%;
            background-image: repeating-linear-gradient(45deg, #ff4c4c 0, #ff4c4c 33px, transparent 0, transparent 41px, #5cb85c 0, #5cb85c 74px, transparent 0, transparent 82px);
            /* Used Oishipan's green instead of blue for the stripe to match branding */
        }
        
        .address-content {
            padding: 1.5rem;
        }

        .address-header {
            color: var(--accent-green);
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .address-details {
            display: flex;
            align-items: baseline;
            gap: 1rem;
            font-size: 1rem;
        }

        .address-name-phone {
            font-weight: 700;
            color: var(--text-dark);
            min-width: max-content;
        }

        .address-text {
            color: var(--text-muted);
            flex: 1;
        }

        .default-badge {
            font-size: 0.75rem;
            color: var(--accent-red);
            border: 1px solid var(--accent-red);
            padding: 0.1rem 0.4rem;
            border-radius: 3px;
            margin-left: 0.5rem;
        }

        .change-btn {
            color: var(--accent-green);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            background: none;
            border: none;
        }

        /* Products Section */
        .products-table-wrap {
            padding: 1.5rem;
        }

        .products-header {
            display: grid;
            grid-template-columns: 4fr 1fr 1fr 1fr;
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .product-row {
            display: grid;
            grid-template-columns: 4fr 1fr 1fr 1fr;
            align-items: center;
            padding: 1rem 0;
            border-top: 1px dashed var(--border-color);
        }

        .product-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .product-img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 4px;
            border: 1px solid var(--border-color);
        }

        .product-name {
            font-weight: 500;
            color: var(--text-dark);
        }
        
        .product-variant {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* Voucher Section */
        .voucher-section, .shipping-section {
            padding: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px dashed var(--border-color);
        }

        .voucher-input-group {
            display: flex;
            gap: 1rem;
            align-items: center;
        }
        
        .voucher-input {
            border: 1px solid var(--border-color);
            padding: 0.5rem 1rem;
            border-radius: 4px;
            text-transform: uppercase;
        }

        /* Note & Shipping */
        .message-shipping-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            padding: 1.5rem;
            background: #fdfdfd;
        }

        .message-box {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .message-input {
            flex: 1;
            padding: 0.6rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: 4px;
        }

        .shipping-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .shipping-fee {
            font-weight: 600;
        }

        /* Payment Methods */
        .payment-methods-section {
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 2rem;
            border-bottom: 1px dashed var(--border-color);
        }

        .payment-options-row {
            display: flex;
            gap: 1rem;
        }

        .pay-option-btn {
            border: 1px solid var(--border-color);
            background: white;
            padding: 0.5rem 1.5rem;
            border-radius: 4px;
            cursor: pointer;
            transition: 0.2s;
        }

        .pay-option-btn.active {
            border-color: var(--accent-green);
            color: var(--accent-green);
            position: relative;
        }

        .pay-option-btn.active::after {
            content: '✓';
            position: absolute;
            bottom: -1px;
            right: -1px;
            background: var(--accent-green);
            color: white;
            font-size: 0.6rem;
            width: 14px;
            height: 14px;
            border-radius: 50% 0 0 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-left: 2px;
            padding-top: 2px;
        }

        /* Summary Section */
        .summary-section {
            padding: 1.5rem;
            background: #fffafa;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 1rem;
        }

        .summary-row {
            display: flex;
            justify-content: flex-end;
            gap: 2rem;
            width: 300px;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .summary-val {
            font-weight: 500;
            color: var(--text-dark);
        }

        .summary-total {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 1rem;
            padding-top: 1rem;
            border-top: 1px dashed var(--border-color);
            width: 100%;
        }

        .total-label {
            font-size: 1rem;
            color: var(--text-dark);
        }

        .total-amount {
            font-size: 1.5rem;
            color: var(--accent-red);
            font-weight: 600;
        }

        .place-order-btn {
            background: var(--accent-green);
            color: white;
            border: none;
            padding: 0.8rem 3rem;
            font-size: 1.1rem;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.3s;
        }
        
        .place-order-btn:hover {
            background: #113c2b; /* dark green */
        }

        .text-right {
            text-align: right;
        }
        
        .text-center {
            text-align: center;
        }
    </style>
}

<div class="checkout-page">
    <form id="checkout-page-form" method="post" asp-controller="Cart" asp-action="Checkout">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.Path" />
        <input type="hidden" name="BuyNowProductVariantId" value="@buyNowVariantId" />
        <input type="hidden" id="PaymentMethod" name="PaymentMethod" value="COD" />

        <!-- Address Section -->
        <div class="checkout-section">
            <div class="address-stripe"></div>
            <div class="address-content">
                <div class="address-header">
                    <i class="bi bi-geo-alt-fill"></i> Địa Chỉ Nhận Hàng
                </div>
                <div class="address-details" id="display-address">
                    <div class="address-name-phone">
                        <span id="display-name">@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "Chưa có tên" : Model.CustomerName)</span> 
                        (<span id="display-phone">@(string.IsNullOrWhiteSpace(Model.CustomerPhone) ? "Chưa có SĐT" : Model.CustomerPhone)</span>)
                    </div>
                    <div class="address-text" id="display-full-address">
                        @(string.IsNullOrWhiteSpace(Model.CustomerAddress) ? "Vui lòng nhập địa chỉ nhận hàng" : Model.CustomerAddress)
                        <span class="default-badge">Mặc Định</span>
                    </div>
                    <button type="button" class="change-btn" id="open-address-modal-btn">Thay Đổi</button>
                </div>

                <!-- Hidden inputs for form submission -->
                <input type="hidden" id="CustomerName" name="CustomerName" value="@Model.CustomerName" required />
                <input type="hidden" id="CustomerPhone" name="CustomerPhone" value="@Model.CustomerPhone" required />
                <input type="hidden" id="CustomerAddress" name="CustomerAddress" value="@Model.CustomerAddress" required />
            </div>
        </div>

        <!-- Products Section -->
        <div class="checkout-section">
            <div class="products-table-wrap">
                <h3 style="margin-bottom: 1.5rem; font-size: 1.1rem;">Sản phẩm</h3>
                <div class="products-header">
                    <div></div>
                    <div class="text-center">Đơn giá</div>
                    <div class="text-center">Số lượng</div>
                    <div class="text-right">Thành tiền</div>
                </div>

                @foreach(var item in checkoutItems)
                {
                    <div class="product-row">
                        <div class="product-info">
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="@item.Image" alt="@item.Name" class="product-img" />
                            }
                            else
                            {
                                <div class="product-img" style="display:flex;align-items:center;justify-content:center;background:#f0f0f0;">
                                    <i class="bi bi-image" style="color:#aaa;"></i>
                                </div>
                            }
                            <div>
                                <div class="product-name">@item.Name</div>
                                @if(!string.IsNullOrEmpty(item.VariantName))
                                {
                                    <div class="product-variant">Phân loại: @item.VariantName</div>
                                }
                            </div>
                        </div>
                        <div class="text-center text-muted">@item.UnitPrice.ToString("N0")đ</div>
                        <div class="text-center">@item.Quantity</div>
                        <div class="text-right text-dark" style="font-weight:500;">@item.LineTotal.ToString("N0")đ</div>
                    </div>
                }
            </div>

            <!-- Message & Shipping -->
            <div class="message-shipping-grid">
                <div class="message-box">
                    <label style="white-space: nowrap;">Lời nhắn:</label>
                    <input type="text" class="message-input" placeholder="Lưu ý cho Người bán..." />
                </div>
                <div class="shipping-info">
                    <div class="text-muted">Phương thức vận chuyển (Dự kiến 1-2 ngày)</div>
                    <div class="shipping-fee text-dark">Miễn phí giao hàng</div>
                </div>
            </div>
        </div>

        <!-- Voucher Section -->
        <div class="checkout-section">
            <div class="voucher-section">
                <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.1rem;">
                    <i class="bi bi-ticket-perforated" style="color: var(--accent-red);"></i> Voucher Oishipan
                </div>
                <div class="voucher-input-group">
                    <input type="text" id="VoucherCode" name="VoucherCode" class="voucher-input" placeholder="Nhập mã voucher" value="@Model.VoucherCode" />
                    <button type="button" id="apply-page-voucher-btn" class="change-btn">Áp Dụng</button>
                    <span id="page-voucher-message" style="display:none; font-size: 0.85rem; font-weight: 500;"></span>
                </div>
            </div>
        </div>

        <!-- Summary Section -->
        <div class="checkout-section">
            <div class="payment-methods-section">
                <div style="font-size: 1.1rem;">Phương thức thanh toán</div>
                <div class="payment-options-row">
                    <button type="button" class="pay-option-btn active" data-method="COD">Thanh toán khi nhận hàng</button>
                    <button type="button" class="pay-option-btn" data-method="BANK">Chuyển khoản ngân hàng</button>
                </div>
            </div>

            <div class="summary-section">
                <div class="summary-row">
                    <span>Tổng tiền hàng</span>
                    <span class="summary-val">@totalAmount.ToString("N0")đ</span>
                </div>
                <div class="summary-row" id="discount-row" style="display: none;">
                    <span>Giảm giá Voucher</span>
                    <span class="summary-val" style="color: var(--accent-red);" id="discount-amount">-0đ</span>
                </div>
                <div class="summary-row">
                    <span>Phí vận chuyển</span>
                    <span class="summary-val">0đ</span>
                </div>
                
                <div class="summary-total">
                    <span class="total-label">Tổng thanh toán:</span>
                    <span class="total-amount" id="final-total">@totalAmount.ToString("N0")đ</span>
                    <input type="hidden" id="base-amount" value="@totalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div style="width: 100%; display: flex; justify-content: flex-end; margin-top: 1rem;">
                    <button type="button" class="place-order-btn" id="submit-checkout-btn">Đặt Hàng</button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Address Edit Modal -->
<div class="modal-overlay" id="address-modal-overlay">
    <div class="custom-modal" style="max-width: 500px;">
        <button class="modal-close-btn" id="close-address-modal"><i class="bi bi-x-lg"></i></button>
        <h3 class="modal-title">Cập nhật địa chỉ nhận hàng</h3>
        <div style="margin-top: 1.5rem;">
            <div class="form-group">
                <label>Họ và tên</label>
                <input type="text" id="edit-name" class="form-control" value="@Model.CustomerName" placeholder="Tên người nhận">
            </div>
            <div class="form-group">
                <label>Số điện thoại</label>
                <input type="tel" id="edit-phone" class="form-control" value="@Model.CustomerPhone" placeholder="Số điện thoại liên hệ">
            </div>
            <div class="form-group">
                <label>Tỉnh/Thành phố & Phường/Xã</label>
                <div style="display:flex; flex-direction:column; gap:0.5rem;">
                    <select id="checkoutProvince" class="form-control">
                        <option value="">Chọn Tỉnh/Thành phố</option>
                    </select>
                    <select id="checkoutWard" class="form-control" disabled>
                        <option value="">Chọn Phường/Xã (Quận/Huyện)</option>
                    </select>
                    <input type="text" id="checkoutDetail" class="form-control" placeholder="Số nhà, đường...">
                </div>
            </div>
            <button type="button" class="btn-primary" id="save-address-btn" style="width: 100%; margin-top: 1rem;">Lưu Địa Chỉ</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const addressModal = document.getElementById('address-modal-overlay');
            const openModalBtn = document.getElementById('open-address-modal-btn');
            const closeModalBtn = document.getElementById('close-address-modal');
            const saveAddressBtn = document.getElementById('save-address-btn');
            const submitBtn = document.getElementById('submit-checkout-btn');
            const checkoutForm = document.getElementById('checkout-page-form');

            if(openModalBtn) {
                openModalBtn.addEventListener('click', () => {
                    addressModal.classList.add('open');
                });
            }

            if(closeModalBtn) {
                closeModalBtn.addEventListener('click', () => {
                    addressModal.classList.remove('open');
                });
            }

            if(saveAddressBtn) {
                saveAddressBtn.addEventListener('click', () => {
                    const name = document.getElementById('edit-name').value;
                    const phone = document.getElementById('edit-phone').value;
                    const prov = document.getElementById('checkoutProvince');
                    const ward = document.getElementById('checkoutWard');
                    const detail = document.getElementById('checkoutDetail').value;

                    let address = "";
                    if (prov.value && ward.value) {
                        address = detail ? `${detail}, ${ward.options[ward.selectedIndex].text}, ${prov.options[prov.selectedIndex].text}` 
                                         : `${ward.options[ward.selectedIndex].text}, ${prov.options[prov.selectedIndex].text}`;
                    } else {
                        address = detail;
                    }

                    if(!name || !phone || !address) {
                        alert('Vui lòng nhập đầy đủ thông tin nhận hàng!');
                        return;
                    }

                    document.getElementById('CustomerName').value = name;
                    document.getElementById('CustomerPhone').value = phone;
                    document.getElementById('CustomerAddress').value = address;

                    document.getElementById('display-name').textContent = name;
                    document.getElementById('display-phone').textContent = phone;
                    document.getElementById('display-full-address').textContent = address;

                    addressModal.classList.remove('open');
                });
            }

            const payBtns = document.querySelectorAll('.pay-option-btn');
            payBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    payBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    document.getElementById('PaymentMethod').value = this.dataset.method;
                });
            });

            if (submitBtn) {
                submitBtn.addEventListener('click', function() {
                    const name = document.getElementById('CustomerName').value;
                    const phone = document.getElementById('CustomerPhone').value;
                    const addr = document.getElementById('CustomerAddress').value;

                    if (!name || !phone || !addr) {
                        addressModal.classList.add('open');
                        alert('Vui lòng điền thông tin địa chỉ nhận hàng trước khi thanh toán.');
                        return;
                    }

                    checkoutForm.submit();
                });
            }

            // Voucher logic
            const applyVoucherBtn = document.getElementById('apply-page-voucher-btn');
            if (applyVoucherBtn) {
                applyVoucherBtn.addEventListener('click', async function() {
                    const code = document.getElementById('VoucherCode').value.trim();
                    const msgEl = document.getElementById('page-voucher-message');
                    const baseTotal = parseFloat(document.getElementById('base-amount').value);
                    const discountRow = document.getElementById('discount-row');
                    const discountAmountEl = document.getElementById('discount-amount');
                    const finalTotalEl = document.getElementById('final-total');

                    if (!code) {
                        msgEl.style.display = 'block';
                        msgEl.style.color = 'var(--accent-red)';
                        msgEl.textContent = 'Vui lòng nhập mã';
                        return;
                    }

                    try {
                        const res = await fetch('/Cart/ValidateVoucher', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ Code: code, OrderTotal: baseTotal })
                        });
                        const data = await res.json();

                        msgEl.style.display = 'block';
                        if (data.isValid) {
                            msgEl.style.color = 'var(--accent-green)';
                            msgEl.textContent = 'Áp dụng thành công!';
                            
                            discountRow.style.display = 'flex';
                            discountAmountEl.textContent = '-' + data.discountAmount.toLocaleString('vi-VN') + 'đ';
                            finalTotalEl.textContent = data.finalTotal.toLocaleString('vi-VN') + 'đ';
                        } else {
                            msgEl.style.color = 'var(--accent-red)';
                            msgEl.textContent = data.message || 'Mã không hợp lệ';
                            
                            discountRow.style.display = 'none';
                            finalTotalEl.textContent = baseTotal.toLocaleString('vi-VN') + 'đ';
                        }
                    } catch (e) {
                        console.error(e);
                    }
                });
            }
        });
    </script>
    <script src="~/js/address.js"></script>
}

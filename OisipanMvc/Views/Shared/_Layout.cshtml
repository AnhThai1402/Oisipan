<!DOCTYPE html>
@{
    var cartItems = Context.Session.GetJson<List<CartItemViewModel>>("Cart") ?? new List<CartItemViewModel>();
    var cartTotalQuantity = cartItems.Count;
    var cartTotalAmount = cartItems.Sum(item => item.LineTotal);
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Oishipan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-cart-message="@TempData["CartMessage"]" data-cart-error="@TempData["CartError"]">

    <header id="main-header">
        <a asp-controller="Home" asp-action="Index" class="logo">
            <span class="logo-text">Oishipan</span>
        </a>
        <nav>
            <a asp-controller="Home" asp-action="Index" asp-fragment="hero" class="active">Trang chủ</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="menu">Menu bánh</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="about">Về Oishipan</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="footer">Liên hệ</a>
        </nav>
        <div class="header-actions">
            <button class="icon-btn" id="open-cart-btn" aria-label="Open Cart">
                <i class="bi bi-bag"></i>
                <span class="cart-badge" id="cart-counter">@cartTotalQuantity</span>
            </button>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Orders" asp-action="Index" class="icon-btn" title="Lịch sử đơn hàng">
                    <i class="bi bi-receipt"></i>
                </a>
                <a asp-controller="Vouchers" asp-action="Index" class="icon-btn" title="Vouchers">
                    <i class="bi bi-ticket"></i>
                </a>
                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <a asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="icon-btn"
                       title="Quản trị viên (@User.Identity.Name)">
                        <i class="bi bi-person-gear"></i>
                    </a>
                }
                else
                {
                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Profile"
                       class="icon-btn"
                       title="Hồ sơ của @User.Identity.Name">
                        <i class="bi bi-person-circle"></i>
                    </a>
                }
                <form method="post" asp-controller="Account" asp-action="Logout" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="icon-btn text-danger" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-login">
                    <i class="bi bi-person-circle"></i> Đăng nhập
                </a>
            }
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <div class="cart-backdrop" id="cart-backdrop"></div>

    <div class="cart-sidebar" id="cart-sidebar">
        <div class="cart-header">
            <h3 class="cart-title">Giỏ Bánh Của Bạn</h3>
            <button class="close-cart" id="close-cart-btn">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="cart-items-list" id="cart-items-wrap">
            @if (cartItems.Any())
            {
                @foreach (var item in cartItems)
                {
                    <div class="cart-item" data-product-variant-id="@item.ProductVariantId">
                        <div class="cart-item-icon">
                            @if (!string.IsNullOrWhiteSpace(item.Image))
                            {
                                <img src="@item.Image" alt="@item.Name" />
                            }
                            else
                            {
                                <i class="bi bi-cake2"></i>
                            }
                        </div>
                        <div class="cart-item-details">
                            <span class="cart-item-title">@item.Name</span>
                            @if (!string.IsNullOrEmpty(item.VariantName))
                            {
                                <span class="cart-item-variant" style="font-size:0.8rem; color:var(--text-light); margin-bottom: 2px; display:block;">
                                    @item.VariantName
                                </span>
                            }
                            <span class="cart-item-price">@item.UnitPrice.ToString("N0")đ</span>
                            <div class="cart-item-actions">
                                <button type="button" class="cart-qty-btn cart-qty-decrease" data-product-variant-id="@item.ProductVariantId" data-action="update" data-quantity="@(item.Quantity - 1)">-</button>
                                <span style="font-size: 0.9rem; font-weight: 600;" class="cart-qty-display">@item.Quantity</span>
                                <button type="button" class="cart-qty-btn cart-qty-increase" data-product-variant-id="@item.ProductVariantId" data-action="update" data-quantity="@(item.Quantity + 1)">+</button>
                            </div>
                        </div>
                        <button type="button" class="remove-item cart-remove-btn" data-product-variant-id="@item.ProductVariantId" data-action="remove" title="Xóa khỏi giỏ">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="cart-empty">
                    <i class="bi bi-bag"></i>
                    <strong>Giỏ hàng trống</strong>
                    <span>Chọn món bánh bạn thích để bắt đầu đặt hàng.</span>
                </div>
            }
        </div>
        <div class="cart-footer">
            <div class="cart-total-row">
                <span>Tổng tiền hàng:</span>
                <span class="cart-total-price" id="cart-total-price">@cartTotalAmount.ToString("N0")đ</span>
            </div>
            <a href="@Url.Action("Checkout", "Cart")" class="btn-primary" style="width: 100%; text-align: center; text-decoration: none; @(!cartItems.Any() ? "opacity: 0.7;" : "")" id="cart-checkout-btn">
                Tiến hành thanh toán
            </a>
        </div>
    </div>


    <div class="modal-overlay" id="login-modal-overlay">
        <div class="auth-grid">
            <button class="modal-close-btn" id="close-login-modal"><i class="fa-solid fa-xmark"></i></button>
            <div class="auth-banner">
                <div class="auth-badge-row">
                    <span class="auth-tag">MỚI NHẤT</span>
                    <h4 class="auth-banner-title">Bộ Sưu Tập<br>"MẤN NHÂN"</h4>
                    <p class="auth-banner-desc">Thưởng vị ngọt thanh tươi mát kết hợp vỏ giòn rụm từ nguyên liệu thượng hạng.</p>
                </div>
                <div class="auth-visual-wrap">
                    <div class="auth-bun-container">
                        <div class="auth-glow"></div>
                        <svg class="main-showcase-img" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 140px; height: 140px;">
                            <circle cx="100" cy="100" r="70" fill="#E89B37" />
                            <circle cx="98" cy="98" r="68" fill="url(#authBunGradient)" />
                            <ellipse cx="98" cy="100" rx="42" ry="24" fill="#F4CD91" opacity="0.9" />
                            <circle cx="70" cy="94" r="5" fill="#522D16" />
                            <circle cx="82" cy="88" r="4.5" fill="#522D16" />
                            <circle cx="114" cy="88" r="4.5" fill="#522D16" />
                            <circle cx="126" cy="94" r="5" fill="#522D16" />
                            <circle cx="98" cy="104" r="8" fill="#D32F2F" />
                            <circle cx="96" cy="102" r="2.5" fill="#FF8A80" opacity="0.8" />
                            <defs>
                                <radialGradient id="authBunGradient" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(104 90) rotate(115) scale(75)">
                                    <stop offset="0%" stop-color="#FCD58C" />
                                    <stop offset="50%" stop-color="#ECA343" />
                                    <stop offset="100%" stop-color="#C6791E" />
                                </radialGradient>
                            </defs>
                        </svg>
                        <div class="auth-sparkle" style="top: 5px; right: 10px;">✨</div>
                    </div>
                </div>
                <div class="auth-banner-footer">
                    <div><p class="auth-footer-italic">"Hương vị từ xứ sở Mặt Trời"</p></div>
                    <div class="auth-rating-box"><span class="auth-rating-score">4.9 / 5</span><span class="auth-rating-label">Đánh giá</span></div>
                </div>
            </div>

            <div class="auth-forms-container">
                <div id="login-panel" class="form-card">
                    <div class="auth-header-block">
                        <span class="auth-sub">Chào mừng trở lại</span>
                        <h3 class="auth-title">Đăng Nhập</h3>
                    </div>
                    <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@currentUrl" class="auth-form" onsubmit="event.preventDefault(); validateAndSubmitAuthForm(this);">
                        @Html.AntiForgeryToken()
                        <div class="form-group"><div class="input-wrapper"><span class="input-icon"><i class="fa-regular fa-envelope"></i></span><input type="email" id="login-email" name="Email" class="auth-control" placeholder="Tên tài khoản hoặc Email" required></div></div>
                        <div class="form-group"><div class="input-wrapper"><span class="input-icon"><i class="fa-regular fa-lock"></i></span><input type="password" id="login-password" name="Password" class="auth-control" placeholder="Mật khẩu" required><button type="button" class="eye-btn" onclick="togglePassword('login-password', this)"><i class="fa-regular fa-eye"></i></button></div></div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <label class="checkbox-row"><input type="checkbox" class="checkbox-custom" id="remember-me" name="RememberMe" value="true"><input type="hidden" name="RememberMe" value="false"><span class="checkbox-label">Ghi nhớ đăng nhập</span></label>
                            <a href="javascript:void(0)" onclick="switchAuthPanel('forgot')" class="forgot-link">Quên mật khẩu?</a>
                        </div>
                        <button type="submit" class="btn-auth-submit"><span>Đăng Nhập</span><i class="fa-solid fa-arrow-right"></i></button>
                    </form>
                    <div class="divider">Hoặc</div>
                    <div class="social-row">
                        <button class="social-btn google" onclick="triggerSocialLogin('Google')"><i class="fa-brands fa-google"></i> Google</button>
                        <button class="social-btn facebook" onclick="triggerSocialLogin('Facebook')"><i class="fa-brands fa-facebook-f"></i> Facebook</button>
                    </div>
                    <p class="auth-switch-prompt">Chưa có tài khoản? <a href="javascript:void(0)" onclick="switchAuthPanel('register')" class="auth-switch-link">Đăng ký ngay</a></p>
                </div>

                <div id="register-panel" class="form-card hidden">
                    <div class="auth-header-block">
                        <span class="auth-sub">Đồng hành cùng Oishipan</span>
                        <h3 class="auth-title">Đăng Ký</h3>
                    </div>
                    <form method="post" asp-controller="Account" asp-action="Register" class="auth-form" onsubmit="event.preventDefault(); validateAndSubmitAuthForm(this);">
                        @Html.AntiForgeryToken()
                        <div class="form-group"><div class="input-wrapper"><span class="input-icon"><i class="fa-regular fa-user"></i></span><input type="text" id="reg-name" name="FullName" class="auth-control" placeholder="Họ và Tên của bạn" required></div></div>
                        <div class="form-group"><div class="input-wrapper"><span class="input-icon"><i class="fa-regular fa-envelope"></i></span><input type="email" id="reg-email" name="Email" class="auth-control" placeholder="Địa chỉ Email" required></div></div>
                        <div class="form-group"><div class="input-wrapper"><span class="input-icon"><i class="fa-regular fa-phone"></i></span><input type="tel" id="reg-phone" name="PhoneNumber" class="auth-control" placeholder="Số điện thoại" required></div></div>
                        <div class="form-group"><div class="input-wrapper"><span class="input-icon"><i class="fa-regular fa-map"></i></span><input type="text" id="reg-address" name="Address" class="auth-control" placeholder="Địa chỉ"></div></div>
                        <div class="form-group"><div class="input-wrapper"><span class="input-icon"><i class="fa-regular fa-lock"></i></span><input type="password" id="reg-password" name="Password" class="auth-control" placeholder="Mật khẩu" onkeyup="checkPasswordStrength(this.value)" required><button type="button" class="eye-btn" onclick="togglePassword('reg-password', this)"><i class="fa-regular fa-eye"></i></button></div></div>
                        <div class="form-group"><div class="input-wrapper"><span class="input-icon"><i class="fa-regular fa-lock"></i></span><input type="password" id="reg-confirm-password" name="ConfirmPassword" class="auth-control" placeholder="Nhập lại mật khẩu" required><button type="button" class="eye-btn" onclick="togglePassword('reg-confirm-password', this)"><i class="fa-regular fa-eye"></i></button></div></div>
                        <div class="strength-indicator">
                            <div class="strength-header"><span>Độ mạnh:</span><span id="strength-label">Rất yếu</span></div>
                            <div class="strength-track"><div id="strength-bar" class="strength-bar"></div></div>
                        </div>
                        <div class="form-group">
                            <label class="checkbox-row">
                                <input type="checkbox" class="checkbox-custom" id="agree-terms">
                                <span class="checkbox-label">Tôi đồng ý với Điều khoản và Chính sách.</span>
                            </label>
                        </div>
                        <button type="submit" class="btn-auth-submit"><span>Tạo Tài Khoản</span><i class="fa-solid fa-user-plus"></i></button>
                    </form>
                    <p class="auth-switch-prompt">Đã có tài khoản? <a href="javascript:void(0)" onclick="switchAuthPanel('login')" class="auth-switch-link">Đăng nhập</a></p>
                </div>

                <div id="forgot-panel" class="form-card hidden">
                    <div class="auth-header-block">
                        <h3 class="auth-title">Quên Mật Khẩu?</h3>
                    </div>
                    <form id="forgot-form" onsubmit="handleForgotPasswordRequest(event)" class="auth-form" novalidate>
                        <div class="form-group"><div class="input-wrapper"><span class="input-icon"><i class="fa-regular fa-envelope"></i></span><input type="email" id="forgot-email" class="auth-control" placeholder="Nhập Email đã đăng ký"></div></div>
                        <button type="submit" class="btn-auth-submit"><span>Gửi Yêu Cầu</span><i class="fa-regular fa-paper-plane"></i></button>
                    </form>
                    <div id="forgot-success" class="form-card hidden">
                        <div class="forgot-success-box">
                            <h4 class="success-title">Yêu Cầu Thành Công!</h4>
                            <p class="success-desc">Kiểm tra hộp thư <strong id="sent-email-placeholder"></strong> để đặt lại mật khẩu.</p>
                        </div>
                    </div>
                    <p style="text-align: center;"><a href="javascript:void(0)" onclick="switchAuthPanel('login')" class="btn-back-login"><i class="fa-solid fa-arrow-left"></i> Quay lại Đăng nhập</a></p>
                </div>
            </div>
            
            <script>
                function validateAndSubmitAuthForm(form) {
                    const requiredInputs = form.querySelectorAll('input[required]');
                    let isValid = true;
                    requiredInputs.forEach(input => {
                        if (!input.value.trim()) {
                            isValid = false;
                            input.classList.add('input-error');
                        } else {
                            input.classList.remove('input-error');
                        }
                    });
                    
                    if (!isValid) {
                        triggerToast('Vui lòng điền đầy đủ các trường bắt buộc.', 'warning');
                    } else {
                        form.submit();
                    }
                }
            </script>
        </div>
    </div>

    <div id="toast-container"></div>

    <footer id="footer">
        <div class="footer-grid">
            <div class="footer-logo-desc">
                <a asp-controller="Home" asp-action="Index" class="logo"><span class="logo-text">Oishipan</span></a>
                <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.65;">Oishipan mang đến tinh hoa bánh nướng Nhật Bản cao cấp nóng hổi mỗi ngày.</p>
                <div class="footer-socials">
                    <a href="#" class="icon-btn"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="icon-btn"><i class="fa-brands fa-instagram"></i></a>
                </div>
            </div>
            <div>
                <h4 class="footer-column-title">Liên kết nhanh</h4>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="hero">Trang chủ</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="menu">Thực đơn</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="about">Về Oishipan</a></li>
                </ul>
            </div>
            <div>
                <h4 class="footer-column-title">Hệ thống cửa hàng</h4>
                <ul class="footer-links footer-store-info">
                    <li><i class="fa-solid fa-map-marker-alt"></i> 88 Nguyễn Huệ, Quận 1, TP. HCM</li>
                    <li><i class="fa-solid fa-phone"></i> +84 28 3824 1234</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 Hệ thống cửa hàng Oishipan Bakery.</p>
        </div>
    </footer>

    <script src="~/js/home.js" asp-append-version="true"></script>
    <script src="~/js/money-input.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        /* Fix select2 dropdown z-index for modals/overlays */
        .select2-container--default .select2-dropdown {
            z-index: 9999;
        }
    </style>
    <script>
        const isUserAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
        
        document.addEventListener("DOMContentLoaded", function () {
            if (isUserAuthenticated) {
                fetch('@Url.Action("GetCheckoutProfile", "Account", new { area = "" })')
                    .then(r => r.json())
                    .then(data => {
                        const nameInput = document.getElementById('customer-name');
                        const phoneInput = document.getElementById('customer-phone');
                        const addressContainer = document.getElementById('address-container');
                        const editBtn = document.getElementById('edit-info-btn');

                        if (data.fullName) {
                            nameInput.value = data.fullName;
                            nameInput.readOnly = true;
                            nameInput.style.backgroundColor = '#f8f9fa';
                        }
                        if (data.phoneNumber) {
                            phoneInput.value = data.phoneNumber;
                            phoneInput.readOnly = true;
                            phoneInput.style.backgroundColor = '#f8f9fa';
                        }

                        if (data.fullName || data.phoneNumber) {
                            editBtn.style.display = 'block';
                        }

                        editBtn.addEventListener('click', () => {
                            nameInput.readOnly = false;
                            nameInput.style.backgroundColor = '';
                            phoneInput.readOnly = false;
                            phoneInput.style.backgroundColor = '';
                            
                            if (addressContainer.querySelector('select#customer-address-select')) {
                                showCheckoutAddressForm();
                            }
                            editBtn.style.display = 'none';
                        });

                        if (data.addresses && data.addresses.length > 0) {
                            let selectHTML = '<select id="customer-address-select" class="form-control" onchange="updateAddressInput(this)" style="margin-bottom: 0.5rem;">';
                            data.addresses.forEach(addr => {
                                selectHTML += `<option value="${addr.fullAddress}">${addr.fullAddress}</option>`;
                            });
                            selectHTML += '<option value="OTHER">Nhập địa chỉ khác...</option>';
                            selectHTML += '</select>';
                            selectHTML += '<input type="hidden" id="customer-address" name="CustomerAddress" value="' + data.addresses[0].fullAddress + '">';
                            
                            addressContainer.innerHTML = selectHTML;
                        } else {
                            loadCheckoutProvinces();
                        }
                    })
                    .catch(err => console.error("Could not fetch profile", err));
            } else {
                loadCheckoutProvinces();
            }
        });

        window.updateAddressInput = function(select) {
            if (select.value === 'OTHER') {
                showCheckoutAddressForm();
            } else {
                document.getElementById('customer-address').value = select.value;
            }
        };

        window.showCheckoutAddressForm = function() {
            const container = document.getElementById('address-container');
            if(container) {
                container.innerHTML = `
                    <div style="display:flex; flex-direction:column; gap:0.5rem;">
                        <input type="hidden" id="customer-address" name="CustomerAddress" value="" required>
                        <select id="checkoutProvince" class="form-control">
                            <option value="">Chọn Tỉnh/Thành phố</option>
                        </select>
                        <select id="checkoutWard" class="form-control" disabled>
                            <option value="">Chọn Phường/Xã (Quận/Huyện)</option>
                        </select>
                        <input type="text" id="checkoutDetail" class="form-control" placeholder="Số nhà, đường..." oninput="updateCheckoutAddress()">
                    </div>
                `;
                loadCheckoutProvinces();
                const pSelect = document.getElementById('checkoutProvince');
                const wSelect = document.getElementById('checkoutWard');
                pSelect?.addEventListener('change', () => loadCheckoutWards());
                wSelect?.addEventListener('change', () => updateCheckoutAddress());
            }
        };

        async function fetchAllProvinces() {
            const cacheKey = 'all_provinces_v2';
            let cached = sessionStorage.getItem(cacheKey);
            if (cached) return JSON.parse(cached);
            try {
                const response = await fetch('https://provinces.open-api.vn/api/v2/p/');
                const data = await response.json();
                if (data) sessionStorage.setItem(cacheKey, JSON.stringify(data));
                return data;
            } catch(e) {
                console.error('Lỗi tải Tỉnh/Thành phố:', e);
            }
            return null;
        }

        async function fetchProvinceWards(code) {
            const cacheKey = `province_${code}_wards_v2`;
            let cached = sessionStorage.getItem(cacheKey);
            if (cached) return JSON.parse(cached);
            try {
                const response = await fetch(`https://provinces.open-api.vn/api/v2/p/${code}?depth=2`);
                const data = await response.json();
                if (data && data.wards) {
                    sessionStorage.setItem(cacheKey, JSON.stringify(data.wards));
                    return data.wards;
                }
            } catch(e) {
                console.error('Lỗi tải Phường/Xã:', e);
            }
            return null;
        }

        async function loadCheckoutProvinces() {
            try {
                const data = await fetchAllProvinces();
                if(!data) return;
                const pSelect = document.getElementById('checkoutProvince');
                if(!pSelect) return;
                pSelect.innerHTML = '<option value="">Chọn Tỉnh/Thành phố</option>';
                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.code; opt.textContent = p.name;
                    pSelect.appendChild(opt);
                });
                pSelect.dispatchEvent(new Event('change'));
            } catch (e) {}
        }

        async function loadCheckoutWards() {
            const pSelect = document.getElementById('checkoutProvince');
            const wSelect = document.getElementById('checkoutWard');
            if(!pSelect || !wSelect) return;
            const code = pSelect.value;
            wSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
            wSelect.disabled = true;
            updateCheckoutAddress();
            if(!code) return;
            try {
                const wards = await fetchProvinceWards(code);
                if(wards) {
                    wards.forEach(w => {
                        const opt = document.createElement('option');
                        opt.value = w.code; opt.textContent = w.name;
                        wSelect.appendChild(opt);
                    });
                    wSelect.disabled = false;
                    wSelect.dispatchEvent(new Event('change'));
                }
            } catch(e){}
        }

        window.updateCheckoutAddress = function() {
            const pSelect = document.getElementById('checkoutProvince');
            const wSelect = document.getElementById('checkoutWard');
            const detail = document.getElementById('checkoutDetail');
            const hInput = document.getElementById('customer-address');
            if(pSelect && wSelect && detail && hInput) {
                const p = pSelect.options[pSelect.selectedIndex]?.text || '';
                const w = wSelect.options[wSelect.selectedIndex]?.text || '';
                const dt = detail.value || '';
                if(pSelect.value && wSelect.value && dt) {
                    hInput.value = `${dt.trim()}, ${w}, ${p}`;
                } else {
                    hInput.value = ''; 
                }
            }
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

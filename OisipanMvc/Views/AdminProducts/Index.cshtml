@model List<FrontendMvc.Models.ProductAdminViewModel>

@{
    ViewData["Title"] = "Quan ly san pham";
}

<div class="admin-page-header">
    <div>
        <p class="auth-eyebrow">Admin</p>
        <h1>Quan ly san pham</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Them san pham</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="table-responsive admin-table-wrap">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>San pham</th>
                <th>Danh muc</th>
                <th>Gia</th>
                <th>So luong</th>
                <th class="text-end">Thao tac</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            <div class="admin-product-cell">
                                @if (!string.IsNullOrWhiteSpace(product.Image))
                                {
                                    <img src="@product.Image" alt="@product.Name" />
                                }
                                <div>
                                    <strong>@product.Name</strong>
                                    <span>@product.Description</span>
                                </div>
                            </div>
                        </td>
                        <td>@product.CategoryName</td>
                        <td>@product.Price.ToString("N0") d</td>
                        <td>@product.Quantity</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.ProductId">Sua</a>
                            <form asp-action="Delete" asp-route-id="@product.ProductId" method="post" class="d-inline" onsubmit="return confirm('Ban co chac muon xoa san pham nay?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xoa</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Chua co san pham nao.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model FrontendMvc.Models.ProductAdminViewModel

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="admin-form admin-form-wide">
    <h1>Sửa sản phẩm</h1>

    <form asp-action="Edit" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data" novalidate>
        <input asp-for="ProductId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="_ProductForm" model="Model" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product-variants.js" asp-append-version="true"></script>
}

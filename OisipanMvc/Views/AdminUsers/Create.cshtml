@model FrontendMvc.Models.UserAdminViewModel

@{
    ViewData["Title"] = "Thêm người dùng";
}

<div class="admin-form admin-form-wide">
    <h1>Thêm người dùng</h1>

    <form asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <partial name="_UserFields" model="Model" />

            <div class="col-md-6">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control password-input" type="password" autocomplete="new-password" />
                    <button class="btn btn-outline-secondary toggle-password" type="button">Hiện</button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model List<FrontendMvc.Models.UserAdminViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="admin-page-header">
    <div>
        <p class="auth-eyebrow">Admin</p>
        <h1>Quản lý người dùng</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm người dùng</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="table-responsive admin-table-wrap">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Người dùng</th>
                <th>Số điện thoại</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Đơn hàng</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <strong>@user.FullName</strong>
                            <span class="admin-muted">@user.Email</span>
                        </td>
                        <td>@user.PhoneNumber</td>
                        <td>
                            <span class="badge @(user.Role == "Admin" ? "bg-primary" : "bg-secondary")">
                                @(user.Role == "Admin" ? "Quản trị viên" : "Người dùng")
                            </span>
                        </td>
                        <td>
                            <span class="badge @(user.Status ? "bg-success" : "bg-danger")">
                                @(user.Status ? "Đang hoạt động" : "Đã khóa")
                            </span>
                        </td>
                        <td>@user.OrderCount</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.UserId">Sửa</a>
                            @if (currentUserId != user.UserId.ToString())
                            {
                                <form asp-action="Delete" asp-route-id="@user.UserId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa người dùng này?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Chưa có người dùng nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model StorefrontViewModel
@{
    ViewData["Title"] = "Menu Bánh";
}

<section id="menu" class="section-padding">
    <div class="section-header">
        <span class="section-subtitle">Bộ sưu tập</span>
        <h2 class="section-title">Menu Bánh Đặc Biệt</h2>
        <p class="section-desc">Mỗi chiếc bánh được lấy trực tiếp từ dữ liệu sản phẩm đang bán.</p>
    </div>
    <div class="menu-grid" id="products-grid">
        @await Html.PartialAsync("_ProductGrid", Model.Products)
    </div>
</section>

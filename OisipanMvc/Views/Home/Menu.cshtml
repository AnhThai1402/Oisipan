@model StorefrontViewModel
@{
    ViewData["Title"] = "Menu Bánh";
}

<section id="menu" class="section-padding">
    <div class="section-header">
        <span class="section-subtitle">Bộ sưu tập</span>
        <h2 class="section-title">Menu Bánh Đặc Biệt</h2>
        <p class="section-desc">Mỗi chiếc bánh được lấy trực tiếp từ dữ liệu sản phẩm đang bán.</p>
    </div>

    <div style="display: flex; justify-content: center; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap;">
        <a asp-action="Menu" asp-route-categoryId="" class="btn-outline" style="padding: 0.5rem 1.5rem; text-decoration: none; border-radius: 5px; @(Model.SelectedCategoryId == null ? "background: var(--accent-green); color: white; border-color: var(--accent-green);" : "")">
            Tất cả
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a asp-action="Menu" asp-route-categoryId="@cat.CategoryId" class="btn-outline" style="padding: 0.5rem 1.5rem; text-decoration: none; border-radius: 5px; @(Model.SelectedCategoryId == cat.CategoryId ? "background: var(--accent-green); color: white; border-color: var(--accent-green);" : "")">
                @cat.CategoryName
            </a>
        }
    </div>
    <div class="menu-grid" id="products-grid">
        @await Html.PartialAsync("_ProductGrid", Model.Products)
    </div>

    @if (Model.TotalPages > 1)
    {
        <div style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-top: 3rem;">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Menu" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-page="@(Model.CurrentPage - 1)" class="btn-outline" style="padding: 0.5rem 1rem; border-radius: 5px;">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a asp-action="Menu" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-page="@i" class="btn-outline" style="padding: 0.5rem 1rem; border-radius: 5px; @(Model.CurrentPage == i ? "background: var(--accent-green); color: white; border-color: var(--accent-green);" : "")">
                    @i
                </a>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Menu" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-page="@(Model.CurrentPage + 1)" class="btn-outline" style="padding: 0.5rem 1rem; border-radius: 5px;">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            }
        </div>
    }
</section>

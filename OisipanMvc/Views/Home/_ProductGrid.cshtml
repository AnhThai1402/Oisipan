@model IEnumerable<FrontendMvc.Models.ProductCatalogViewModel>

@if (Model.Any())
{
    foreach (var product in Model)
    {
        var displayPrice = $"{product.Price:N0}đ";

        <article class="product-card">
            <a class="product-card-link"
               asp-controller="Products"
               asp-action="Details"
               asp-route-id="@product.ProductId"
               aria-label="Xem chi tiết @product.Name">
                <div class="product-img-wrap menu-product-image">
                    @if (!string.IsNullOrWhiteSpace(product.Image))
                    {
                        <img class="product-img" src="@product.Image" alt="@product.Name" loading="lazy" />
                    }
                    else
                    {
                        <div class="product-img product-img-fallback" aria-hidden="true">
                            <i class="bi bi-cake2"></i>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                    {
                        <span class="product-tag">@product.CategoryName</span>
                    }
                </div>

                <div class="product-info">
                    <h3 class="product-title">@product.Name</h3>
                    <p class="product-desc">
                        @(string.IsNullOrWhiteSpace(product.Description)
                            ? "Bánh tươi được làm mới mỗi ngày tại Oishipan."
                            : product.Description)
                    </p>
                    <div class="product-footer">
                        <span class="product-price">@displayPrice</span>
                        <span class="product-view-link">Xem chi tiết <i class="bi bi-arrow-right"></i></span>
                    </div>
                </div>
            </a>
            <div class="product-card-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-controller="Wishlist" asp-action="Toggle" class="wishlist-grid-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@product.ProductId" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn-view-detail @(product.IsWishlisted ? "is-wishlisted" : "")" title="@(product.IsWishlisted ? "Bỏ yêu thích" : "Yêu thích sản phẩm")" aria-label="@(product.IsWishlisted ? "Bỏ yêu thích" : "Yêu thích") @product.Name">
                            <i class="bi @(product.IsWishlisted ? "bi-heart-fill" : "bi-heart")"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn-view-detail" title="Đăng nhập để yêu thích" aria-label="Yêu thích @product.Name">
                        <i class="bi bi-heart"></i>
                    </a>
                }
                @if (product.StockQuantity > 0)
                {
                    <a asp-controller="Cart" asp-action="Checkout" asp-route-buyNowProductId="@product.ProductId" asp-route-buyNowQuantity="1" class="buy-now-card-btn" title="Mua ngay @product.Name">
                        <i class="bi bi-lightning-charge-fill"></i> Mua ngay
                    </a>
                }
            </div>
        </article>
    }
}
else
{
    <div class="product-card">
        <div class="product-info">
            <h3 class="product-title">Chưa có sản phẩm</h3>
            <p class="product-desc">Danh sách bánh đang được cập nhật.</p>
        </div>
    </div>
}

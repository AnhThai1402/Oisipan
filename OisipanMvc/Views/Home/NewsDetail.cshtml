@model FrontendMvc.Models.NewsArticleViewModel

@{
    ViewData["Title"] = Model.Title;
    var containsHtml = System.Text.RegularExpressions.Regex.IsMatch(
        Model.Content,
        @"</?[a-z][\s\S]*>",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    var safeContent = Model.Content;

    if (containsHtml)
    {
        safeContent = System.Text.RegularExpressions.Regex.Replace(
            safeContent,
            @"<(script|style|iframe|object|embed)\b[^>]*>[\s\S]*?</\1>",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        safeContent = System.Text.RegularExpressions.Regex.Replace(
            safeContent,
            @"\s(?:style|class|id|data-[\w-]+|aria-[\w-]+|role|on[\w-]+)\s*=\s*(?:""[^""]*""|'[^']*')",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }
}

<article class="news-detail">
    <a class="news-back-link" asp-action="News">← Tin tức</a>

    <header class="news-detail-header">
        <h1>@Model.Title</h1>
    </header>

    <div class="news-content">
        @if (containsHtml)
        {
            @Html.Raw(safeContent)
        }
        else
        {
            @foreach (var paragraph in Model.Content.Split(
                new[] { "\r\n\r\n", "\n\n" },
                StringSplitOptions.RemoveEmptyEntries))
            {
                <p>@paragraph</p>
            }
        }
    </div>
</article>

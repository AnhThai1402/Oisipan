@model FrontendMvc.Models.NewsArticleViewModel

@{
    ViewData["Title"] = Model.Title;
    var containsHtml = System.Text.RegularExpressions.Regex.IsMatch(
        Model.Content,
        @"</?[a-z][\s\S]*>",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    var safeContent = Model.Content;

    if (containsHtml)
    {
        safeContent = System.Text.RegularExpressions.Regex.Replace(
            safeContent,
            @"<(script|style|iframe|object|embed)\b[^>]*>[\s\S]*?</\1>",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        safeContent = System.Text.RegularExpressions.Regex.Replace(
            safeContent,
            @"\s(?:style|class|id|data-[\w-]+|aria-[\w-]+|role|on[\w-]+)\s*=\s*(?:""[^""]*""|'[^']*')",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }
}

<article class="news-detail" style="max-width: 980px; margin: 0 auto; padding: 8rem 1rem 5rem;">
    @if (!string.IsNullOrEmpty(Model.Image))
    {
        <div style="margin-bottom: 2rem;">
            <img src="@Model.Image" alt="@Model.Title" style="width: 100%; height: auto; max-height: 500px; object-fit: cover; border-radius: 5px; box-shadow: 0 4px 15px rgba(0,0,0,0.08);" />
        </div>
    }

    <div style="background: #fff; padding: 2.5rem; border-radius: 5px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.05);">
        <div style="margin-bottom: 1.5rem;">
            <a asp-action="News" style="color: var(--text-muted); text-decoration: none; font-weight: 500; font-size: 0.95rem; transition: color 0.2s;">
                ← Bài viết
            </a>
        </div>

        <header style="margin-bottom: 2rem;">
            <small style="display: block; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.8rem;">Ngày đăng: @((Model.PublishedAt ?? Model.CreatedAt).ToString("dd/MM/yyyy"))</small>
            <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--accent-green); margin-bottom: 0.5rem; line-height: 1.2;">@Model.Title</h1>
        </header>

        <div class="news-content" style="font-size: 1.05rem; line-height: 1.7; color: var(--text-main);">
            @if (containsHtml)
            {
                @Html.Raw(safeContent)
            }
            else
            {
                @foreach (var paragraph in Model.Content.Split(
                    new[] { "\r\n\r\n", "\n\n" },
                    StringSplitOptions.RemoveEmptyEntries))
                {
                    <p style="margin-bottom: 1rem;">@paragraph</p>
                }
            }
        </div>
    </div>
</article>

@{
    ViewData["Title"] = "Tin Tức";
}

<section id="news" class="section-padding">
    <div class="section-header">
        <span class="section-subtitle">Blog</span>
        <h2 class="section-title">Tin Tức Mới Nhất</h2>
        <p class="section-desc">Cập nhật những thông tin và mẹo chế tác bánh mới nhất</p>
    </div>
    <div class="menu-grid">
        <div class="product-card">
            <div class="product-img-wrap">
                <i class="fa-solid fa-utensils" style="font-size: 3rem; color: var(--accent-green);"></i>
            </div>
            <div class="product-info">
                <h3 class="product-title">Cách chế tác bánh perfect</h3>
                <p class="product-desc">Hướng dẫn chi tiết cách chế tác bánh mẫn nhân hoàn hảo cho những người mới bắt đầu</p>
            </div>
        </div>
        <div class="product-card">
            <div class="product-img-wrap">
                <i class="fa-solid fa-leaf" style="font-size: 3rem; color: var(--accent-orange);"></i>
            </div>
            <div class="product-info">
                <h3 class="product-title">Nguyên liệu tự nhiên</h3>
                <p class="product-desc">Những lợi ích của việc sử dụng nguyên liệu tự nhiên trong sản xuất bánh</p>
            </div>
        </div>
        <div class="product-card">
            <div class="product-img-wrap">
                <i class="fa-solid fa-gift" style="font-size: 3rem; color: var(--accent-red);"></i>
            </div>
            <div class="product-info">
                <h3 class="product-title">Khuyến mãi tháng này</h3>
                <p class="product-desc">Nhận ngay ưu đãi đặc biệt khi mua 2 chiếc bánh trở lên</p>
            </div>
        </div>
    </div>
</section>

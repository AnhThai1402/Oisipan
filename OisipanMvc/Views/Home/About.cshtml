@{
    ViewData["Title"] = "Về Oishipan";
}

<section id="about" class="section-padding">
    <div class="section-header">
        <span class="section-subtitle">Chúng tôi</span>
        <h2 class="section-title">Về Oishipan</h2>
    </div>
    <div class="about-grid">
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div class="about-perk-card">
                <div class="perk-icon-wrap">
                    <i class="fa-solid fa-check"></i>
                </div>
                <div>
                    <h3 style="font-size: 1rem; color: var(--accent-green); font-weight: 700; margin-bottom: 0.3rem;">Nguyên liệu cao cấp</h3>
                    <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">Tất cả bánh được làm từ nguyên liệu nhập khẩu từ Nhật Bản, đảm bảo chất lượng tốt nhất</p>
                </div>
            </div>
            <div class="about-perk-card">
                <div class="perk-icon-wrap">
                    <i class="fa-solid fa-heart"></i>
                </div>
                <div>
                    <h3 style="font-size: 1rem; color: var(--accent-green); font-weight: 700; margin-bottom: 0.3rem;">Được yêu thích</h3>
                    <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">Hàng ngàn khách hàng tin tưởng và yêu thích những sản phẩm của chúng tôi</p>
                </div>
            </div>
            <div class="about-perk-card">
                <div class="perk-icon-wrap">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <div>
                    <h3 style="font-size: 1rem; color: var(--accent-green); font-weight: 700; margin-bottom: 0.3rem;">Giao hàng nhanh</h3>
                    <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">Đảm bảo giao hàng nhanh chóng và an toàn đến tay khách hàng</p>
                </div>
            </div>
        </div>
        <div style="background: var(--bg-white); border-radius: 5px; padding: 2rem; display: flex; align-items: center; justify-content: center; min-height: 400px;">
            <div style="text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem;">
                    <i class="fa-solid fa-bread-slice" style="color: var(--accent-orange);"></i>
                </div>
                <h3 style="font-family: var(--font-serif); font-size: 1.8rem; color: var(--accent-green); margin-bottom: 1rem;">Oishipan</h3>
                <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.7; max-width: 300px;">Chúng tôi là một tiệm bánh chuyên nghiệp, mang đến những chiếc bánh ngọt chất lượng cao từ nền ẩm thực Nhật Bản.</p>
            </div>
        </div>
    </div>
</section>

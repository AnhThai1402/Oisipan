@model StorefrontViewModel

@{
    ViewData["Title"] = "Trang Chủ";

    var heroBanners = Model.BannersHero
        .Where(x => x.IsActive)
        .OrderBy(x => x.DisplayOrder)
        .ToList();
}

<style>
    /* =========================
           HERO SLIDER
           ========================= */

    .hero-carousel {
        position: relative;
        width: 100vw;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: var(--bg-card);
    }

    .hero-track {
        display: flex;
        width: 100%;
        min-height: 100vh;
        transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .hero-slide {
        position: relative;
        flex: 0 0 100%;
        width: 100%;
        min-height: 100vh;
        box-sizing: border-box;
        overflow: hidden;
    }

    /* =========================
           BANNER
           ========================= */

    .auth-banner {
        position: relative;
        width: 100%;
        min-height: 100vh;
        padding: 4rem 8%;
        box-sizing: border-box;
        overflow: hidden;
        display: flex;
        align-items: center;
    }

    /* =========================
           LEFT CONTENT
           ========================= */

    .auth-badge-row {
        position: absolute;
        left: 8%;
        top: 50%;
        transform: translateY(-50%);
        max-width: 500px;
        z-index: 5;
    }

        .auth-badge-row h1 {
            font-size: 3rem;
            color: white;
            margin: 0 0 0.5rem;
        }

        .auth-badge-row > p {
            font-size: 1.2rem;
            color: white;
            margin-bottom: 1.5rem;
        }

    .auth-tag {
        display: inline-block;
        padding: 0.4rem 1rem;
        background: var(--accent-green);
        color: white;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .auth-banner-title {
        font-size: 2.5rem;
        line-height: 1.2;
        color: white;
        margin: 1.5rem 0 1rem;
    }

    .auth-banner-desc {
        max-width: 450px;
        color: white;
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: 1.5rem;
    }

    /* =========================
           IMAGE
           ========================= */

    .auth-visual-wrap {
        position: absolute;
        top: 50%;
        right: 15%;
        transform: translateY(-50%);
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .main-showcase-img {
        max-width: 520px;
        max-height: 520px;
        width: 100%;
        height: auto;
        object-fit: contain;
        border-radius: 20px;
        transition: transform 0.5s ease;
    }

    .hero-slide:hover .main-showcase-img {
        transform: scale(1.03);
    }

    /* =========================
           FOOTER
           ========================= */

    .auth-banner-footer {
        position: absolute;
        left: 8%;
        bottom: 5%;
        z-index: 5;
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .auth-footer-italic {
        margin: 0;
        color: white;
        font-style: italic;
    }

    .auth-rating-box {
        display: flex;
        flex-direction: column;
    }

    .auth-rating-score {
        color: white;
        font-weight: 700;
    }

    .auth-rating-label {
        color: white;
        font-size: 0.8rem;
    }

    /* =========================
           PREV / NEXT
           ========================= */

    .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 52px;
        height: 52px;
        border: none;
        border-radius: 50%;
        background: rgba(17, 60, 43, 0.55);
        color: white;
        cursor: pointer;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        transition: background 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
    }

        .carousel-btn:hover {
            background: var(--accent-green);
            transform: translateY(-50%) scale(1.08);
        }

        .carousel-btn.prev {
            left: 25px;
        }

        .carousel-btn.next {
            right: 25px;
        }

    /* =========================
           DOTS
           ========================= */

    .carousel-dots {
        position: absolute;
        left: 50%;
        bottom: 30px;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 8px;
        z-index: 50;
    }

    .dot {
        width: 12px;
        height: 12px;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.5);
        cursor: pointer;
        transition: width 0.3s ease, background 0.3s ease, border-radius 0.3s ease;
    }

        .dot:hover {
            background: white;
        }

        .dot.active {
            width: 30px;
            border-radius: 6px;
            background: var(--accent-green);
        }

    /* =========================
           EMPTY BANNER
           ========================= */

    .hero-empty {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
    }

    /* =========================
           MOBILE
           ========================= */

    @@media (max-width: 992px) {

        .auth-banner {
            padding: 3rem 5rem;
        }

        .auth-badge-row {
            left: 7%;
            max-width: 400px;
        }

            .auth-badge-row h1 {
                font-size: 2.3rem;
            }

        .auth-banner-title {
            font-size: 2rem;
        }

        .auth-visual-wrap {
            right: 5%;
        }

        .main-showcase-img {
            width: 320px;
            height: 320px;
        }

        .carousel-btn.prev {
            left: 15px;
        }

        .carousel-btn.next {
            right: 15px;
        }
    }

    @@media (max-width: 768px) {

        .hero-carousel,
        .hero-track,
        .hero-slide,
        .auth-banner {
            min-height: 100vh;
        }

        .auth-banner {
            padding: 2rem;
            display: block;
        }

        .auth-badge-row {
            position: absolute;
            top: 15%;
            left: 50%;
            transform: translateX(-50%);
            width: 80%;
            max-width: none;
            text-align: center;
        }

            .auth-badge-row h1 {
                font-size: 2rem;
            }

            .auth-badge-row > p {
                font-size: 1rem;
            }

        .auth-banner-title {
            font-size: 1.7rem;
        }

        .auth-banner-desc {
            font-size: 0.9rem;
            margin-left: auto;
            margin-right: auto;
        }

        .auth-visual-wrap {
            position: absolute;
            top: 55%;
            left: 50%;
            right: auto;
            transform: translate(-50%, -50%);
        }

        .main-showcase-img {
            width: 260px;
            height: 260px;
        }

        .auth-banner-footer {
            display: none;
        }

        .carousel-btn {
            width: 42px;
            height: 42px;
            font-size: 1rem;
        }

            .carousel-btn.prev {
                left: 10px;
            }

            .carousel-btn.next {
                right: 10px;
            }

        .carousel-dots {
            bottom: 20px;
        }
    }

    @@media (max-width: 480px) {

        .auth-badge-row {
            top: 12%;
            width: 75%;
        }

            .auth-badge-row h1 {
                font-size: 1.6rem;
            }

        .auth-banner-title {
            font-size: 1.4rem;
        }

        .auth-banner-desc {
            font-size: 0.8rem;
        }

        .main-showcase-img {
            width: 220px;
            height: 220px;
        }

        .carousel-btn {
            width: 38px;
            height: 38px;
        }

        .banner-image-link {
            display: block;
            cursor: pointer;
            text-decoration: none;
        }

            .banner-image-link .main-showcase-img {
                display: block;
            }

            .banner-image-link:hover .main-showcase-img {
                transform: scale(1.05);
            }
    }
</style>


<!-- =========================
     HERO
     ========================= -->

<section class="hero-carousel" id="hero">

    @if (heroBanners.Any())
    {
        <!-- SLIDER TRACK -->
        <div class="hero-track" id="heroTrack">

            @foreach (var banner in heroBanners)
            {
                <div class="hero-slide">

                    <div class="auth-banner">

                        <!-- =====================
                             PREV
                             ===================== -->

                        <button type="button"
                                class="carousel-btn prev"
                                id="prevBtn"
                                aria-label="Banner trước">
                            <i class="bi bi-chevron-left"></i>
                        </button>


                        <!-- =====================
                             CONTENT
                             ===================== -->

                        <div class="auth-badge-row">

                            <h1>
                                Oishipan Bakery
                            </h1>

                            <p>
                                Bánh ngọt phong cách Nhật Bản
                            </p>

                            <span class="auth-tag">
                                MỚI NHẤT
                            </span>

                            <h4 class="auth-banner-title">
                                @banner.Title
                            </h4>

                            <p class="auth-banner-desc">
                                Thưởng vị ngọt thanh tươi mát
                                kết hợp vỏ giòn rụm từ nguyên liệu
                                thượng hạng.
                            </p>

                           

                        </div>


                        <!-- =====================
                             IMAGE
                             ===================== -->

                        <div class="auth-visual-wrap">

                            @if (!string.IsNullOrWhiteSpace(banner.ImageUrl))
                            {
                                @if (!string.IsNullOrWhiteSpace(banner.Link))
                                {
                                    <a href="@banner.Link"
                                       class="banner-image-link"
                                       aria-label="Xem @banner.Title">

                                        <img src="@banner.ImageUrl"
                                             alt="@banner.Title"
                                             class="main-showcase-img" />

                                    </a>
                                }
                                else
                                {
                                    <img src="@banner.ImageUrl"
                                         alt="@banner.Title"
                                         class="main-showcase-img" />
                                }
                            }

                        </div>


                        <!-- =====================
                             FOOTER
                             ===================== -->

                        <div class="auth-banner-footer">

                            <p class="auth-footer-italic">
                                "Hương vị từ xứ sở Mặt Trời"
                            </p>

                            <div class="auth-rating-box">

                                <span class="auth-rating-score">
                                    4.9 / 5
                                </span>

                                <span class="auth-rating-label">
                                    Đánh giá
                                </span>

                            </div>

                        </div>


                        <!-- =====================
                             NEXT
                             ===================== -->

                        <button type="button"
                                class="carousel-btn next"
                                id="nextBtn"
                                aria-label="Banner tiếp theo">
                            <i class="bi bi-chevron-right"></i>
                        </button>

                    </div>

                </div>
            }

        </div>


        <!-- =========================
             DOTS
             ========================= -->

        <div class="carousel-dots" id="carouselDots">

            @for (int i = 0; i < heroBanners.Count; i++)
            {
                <button type="button"
                        class="dot @(i == 0 ? "active" : "")"
                        data-slide="@i"
                        aria-label="Đi tới banner @(i + 1)">
                </button>
            }

        </div>

    }
    else
    {
        <div class="hero-empty">
            <h3>Chưa có banner.</h3>
        </div>
    }

</section>
<section id="about" class="section-padding">
    <div class="section-header">
        <span class="section-subtitle">Câu Chuyện Của Chúng Tôi</span>
        <h2 class="section-title">Về Oishipan Bakery</h2>
        <p class="section-desc">Khởi nguồn từ niềm đam mê ẩm thực Nhật Bản thanh tao, Oishipan là sự kết tinh của nghệ thuật làm bánh thủ công truyền thống.</p>
    </div>
    <div class="about-grid" id="about-grid">
        <div>
            <h3 style="font-family: var(--font-serif); font-size: 1.8rem; color: var(--accent-green); margin-bottom: 1.2rem; font-weight: 700;">Nghệ Thuật Nhào Bột Thủ Công</h3>
            <p style="color: var(--text-muted); line-height: 1.75; font-size: 0.95rem; margin-bottom: 1.5rem;">
                Tại Oishipan, mỗi ổ bánh đều là một tác phẩm nghệ thuật riêng biệt. Chúng tôi sử dụng men tự nhiên chuẩn Nhật Bản...
            </p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div class="about-perk-card">
                <div class="perk-icon-wrap"><i class="fa-solid fa-wheat-awn"></i></div>
                <div>
                    <h4 style="font-family: var(--font-serif); font-size: 1.15rem; color: var(--accent-green); font-weight: 700; margin-bottom: 0.3rem;">Bột Mì Hokkaido Thượng Hạng</h4>
                    <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5;">Bột mì mịn màng dệt từ lúa mạch vụ xuân vùng tuyết lạnh Hokkaido.</p>
                </div>
            </div>
            <div class="about-perk-card">
                <div class="perk-icon-wrap"><i class="fa-solid fa-clock"></i></div>
                <div>
                    <h4 style="font-family: var(--font-serif); font-size: 1.15rem; color: var(--accent-green); font-weight: 700; margin-bottom: 0.3rem;">Ủ Men Chậm 72 Giờ</h4>
                    <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5;">Thời gian ủ men chậm lý tưởng giúp giải phóng toàn bộ hương thơm tinh khiết.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="menu" class="section-padding">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1.5rem; max-width: 1440px; margin: 0 auto 4rem;">
        <div class="section-header" style="margin: 0; align-items: flex-start; text-align: left;">
            <span class="section-subtitle">Thực Đơn Mùa Hè</span>
            <h2 class="section-title">Tinh Hoa Bánh Nướng Oishipan</h2>
        </div>
        <a asp-controller="Home" asp-action="Menu" class="btn-outline" style="padding: 0.6rem 1.5rem; font-size: 0.9rem; margin-bottom: 0.5rem;">
            Xem tất cả <i class="bi bi-arrow-right" style="margin-left: 0.3rem;"></i>
        </a>
    </div>
    <div class="menu-grid" id="menu-items-container">
        @await Html.PartialAsync("_ProductGrid", Model.Products.Take(4).ToList())
    </div>
</section>

<!-- =========================
     JAVASCRIPT
     ========================= -->
@if (heroBanners.Count > 0)
{
    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const track = document.getElementById("heroTrack");

            const slides =
                document.querySelectorAll(".hero-slide");

            const dots =
                document.querySelectorAll(".dot");

            const prevBtns =
                document.querySelectorAll(".carousel-btn.prev");

            const nextBtns =
                document.querySelectorAll(".carousel-btn.next");


            if (!track || slides.length === 0) {
                return;
            }


            let currentSlide = 0;

            let autoSlide;


            /* =========================
               SHOW SLIDE
               ========================= */

            function showSlide(index) {

                if (index < 0) {
                    index = slides.length - 1;
                }

                if (index >= slides.length) {
                    index = 0;
                }

                currentSlide = index;


                track.style.transform =
                    `translateX(-${currentSlide * 100}%)`;


                dots.forEach((dot, i) => {

                    dot.classList.toggle(
                        "active",
                        i === currentSlide
                    );

                });

            }


            /* =========================
               NEXT
               ========================= */

            function nextSlide() {

                showSlide(currentSlide + 1);

                resetAutoSlide();

            }


            /* =========================
               PREVIOUS
               ========================= */

            function prevSlide() {

                showSlide(currentSlide - 1);

                resetAutoSlide();

            }


            /* =========================
               NEXT BUTTON
               ========================= */

            nextBtns.forEach(button => {

                button.addEventListener(
                    "click",
                    nextSlide
                );

            });


            /* =========================
               PREV BUTTON
               ========================= */

            prevBtns.forEach(button => {

                button.addEventListener(
                    "click",
                    prevSlide
                );

            });


            /* =========================
               DOT
               ========================= */

            dots.forEach(dot => {

                dot.addEventListener(
                    "click",
                    function() {

                        const index =
                            parseInt(
                                this.dataset.slide
                            );

                        showSlide(index);

                        resetAutoSlide();

                    }
                );

            });


            /* =========================
               AUTO SLIDE
               ========================= */

            function startAutoSlide() {

                autoSlide = setInterval(
                    function() {

                        showSlide(
                            currentSlide + 1
                        );

                    },
                    5000
                );

            }


            /* =========================
               RESET AUTO SLIDE
               ========================= */

            function resetAutoSlide() {

                clearInterval(autoSlide);

                startAutoSlide();

            }


            /* =========================
               START
               ========================= */

            showSlide(0);

            startAutoSlide();


            /* =========================
               KEYBOARD
               ========================= */

            document.addEventListener(
                "keydown",
                function(event) {

                    if (event.key === "ArrowLeft") {
                        prevSlide();
                    }

                    if (event.key === "ArrowRight") {
                        nextSlide();
                    }

                }
            );


            /* =========================
               TOUCH SWIPE
               ========================= */

            let touchStartX = 0;

            let touchEndX = 0;


            track.addEventListener(
                "touchstart",
                function(event) {

                    touchStartX =
                        event.changedTouches[0].screenX;

                },
                { passive: true }
            );


            track.addEventListener(
                "touchend",
                function(event) {

                    touchEndX =
                        event.changedTouches[0].screenX;

                    handleSwipe();

                },
                { passive: true }
            );


            function handleSwipe() {

                const distance =
                    touchEndX - touchStartX;


                if (Math.abs(distance) < 50) {
                    return;
                }


                if (distance < 0) {
                    nextSlide();
                }
                else {
                    prevSlide();
                }

            }

        });

    </script>
}
@model ProductCatalogViewModel
@{
    ViewData["Title"] = Model.Name;
}

<section class="product-detail-page" data-product-detail data-has-options="@selectableOptions.Any().ToString().ToLowerInvariant()" data-base-price="@Model.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">
    <a class="product-detail-back" asp-controller="Home" asp-action="Menu">
        <i class="bi bi-arrow-left"></i> Quay lại menu bánh
    </a>

    <div class="product-detail-grid">
        <div class="product-detail-visual">
            @if (!string.IsNullOrWhiteSpace(Model.Image))
            {
                <img src="@Model.Image" alt="@Model.Name" />
            }
            else
            {
                <div class="product-detail-fallback" aria-hidden="true">
                    <i class="bi bi-cake2"></i>
                </div>
            }
        </div>

        <div class="product-detail-info">
            @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
            {
                <span class="product-detail-category">@Model.CategoryName</span>
            }

            <h1>@Model.Name</h1>
            <div class="product-detail-price" data-product-total-price>@Model.Price.ToString("N0")đ</div>

            <div class="product-detail-meta">
                <div>
                    <i class="bi bi-box-seam"></i>
                    <span>Tồn kho</span>
                    <strong id="product-stock-display" data-initial-stock="@Model.StockQuantity">@Model.StockQuantity sản phẩm</strong>
                </div>
                <div>
                    <i class="bi bi-patch-check"></i>
                    <span>Chất lượng</span>
                    <strong>Làm mới mỗi ngày</strong>
                </div>
            </div>

            <form method="post" asp-controller="Cart" asp-action="Add" id="productForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                
                <div class="product-quantity-selector" style="margin: 1rem 0 1.5rem; display: flex; align-items: center; gap: 1rem;">
                    <span style="font-weight: 600; color: var(--text-color);">Số lượng:</span>
                    <div style="display: flex; align-items: center; border: 1px solid var(--border-color); border-radius: 5px; overflow: hidden; background: var(--bg-white); width: 120px;">
                        <button type="button" class="quantity-btn minus" onclick="var q=document.getElementById('quantity'); if(q.value>1)q.value--;" style="flex: 1; padding: 0.5rem 0; border: none; background: none; cursor: pointer; font-size: 1.25rem; color: var(--text-color); display: flex; align-items: center; justify-content: center;">-</button>
                        <input type="number" name="quantity" id="quantity" value="1" min="1" max="@Model.StockQuantity" style="width: 50px; text-align: center; border: none; outline: none; font-size: 1rem; padding: 0.5rem 0; -moz-appearance: textfield; font-weight: 600;" />
                        <button type="button" class="quantity-btn plus" onclick="var q=document.getElementById('quantity'); if(parseInt(q.value)<parseInt(q.max))q.value++;" style="flex: 1; padding: 0.5rem 0; border: none; background: none; cursor: pointer; font-size: 1.25rem; color: var(--text-color); display: flex; align-items: center; justify-content: center;">+</button>
                    </div>
                </div>

                <div class="product-main-actions">
                    <button type="submit" class="btn-main-add-cart">
                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                    </button>
                    <button type="button" class="btn-main-buy-now" onclick="triggerBuyNow('@Model.ProductId')">
                        Mua ngay
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="product-detail-bottom-section" style="max-width: 1200px; margin: 4rem auto 0 auto; padding-top: 2rem; border-top: 1px solid var(--border-color);">
        <h3 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 1rem; color: var(--accent-green); font-family: var(--font-sans);">Mô tả sản phẩm</h3>
        <p class="product-detail-description" style="margin-top: 0; color: var(--text-muted); font-size: 1rem; line-height: 1.8;">
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "Bánh tươi được làm mới mỗi ngày từ những nguyên liệu tuyển chọn tại Oishipan."
                : Model.Description)
        </p>
    </div>
</section>

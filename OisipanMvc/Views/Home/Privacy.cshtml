@{
    ViewData["Title"] = "Chính Sách Bảo Mật";
}

<section class="section-padding" style="background: var(--bg-page);">
    <div class="section-header">
        <span class="section-subtitle">Bảo vệ dữ liệu</span>
        <h2 class="section-title">Chính Sách Bảo Mật</h2>
    </div>
    <div style="max-width: 900px; margin: 0 auto; background: var(--bg-white); border-radius: 5px; padding: 2rem;">
        <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--accent-green); margin: 1.5rem 0 0.75rem;">1. Thông Tin Chúng Tôi Thu Thập</h3>
        <p style="color: var(--text-muted); line-height: 1.7; margin-bottom: 1.5rem;">Chúng tôi thu thập thông tin cá nhân mà bạn cung cấp trực tiếp khi đặt hàng, đăng ký tài khoản hoặc liên hệ với chúng tôi. Thông tin này có thể bao gồm tên, email, số điện thoại và địa chỉ giao hàng.</p>
        
        <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--accent-green); margin: 1.5rem 0 0.75rem;">2. Cách Sử Dụng Thông Tin</h3>
        <p style="color: var(--text-muted); line-height: 1.7; margin-bottom: 1.5rem;">Chúng tôi sử dụng thông tin của bạn để xử lý đơn hàng, cung cấp dịch vụ khách hàng, gửi thông tin về sản phẩm mới và cải thiện trải nghiệm của bạn trên website.</p>
        
        <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--accent-green); margin: 1.5rem 0 0.75rem;">3. Bảo Mật Thông Tin</h3>
        <p style="color: var(--text-muted); line-height: 1.7; margin-bottom: 1.5rem;">Chúng tôi cam kết bảo vệ thông tin cá nhân của bạn bằng các biện pháp bảo mật tiên tiến. Tất cả dữ liệu được mã hóa và lưu trữ an toàn trên các máy chủ được bảo vệ.</p>
        
        <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--accent-green); margin: 1.5rem 0 0.75rem;">4. Quyền Của Bạn</h3>
        <p style="color: var(--text-muted); line-height: 1.7; margin-bottom: 1.5rem;">Bạn có quyền yêu cầu xem, chỉnh sửa hoặc xóa thông tin cá nhân của mình bất kỳ lúc nào bằng cách liên hệ với chúng tôi qua email hoặc điện thoại.</p>
        
        <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--accent-green); margin: 1.5rem 0 0.75rem;">5. Thay Đổi Chính Sách</h3>
        <p style="color: var(--text-muted); line-height: 1.7;">Oishipan có quyền cập nhật chính sách bảo mật này bất kỳ lúc nào. Những thay đổi sẽ được công bố trên trang web này.</p>
    </div>
</section>

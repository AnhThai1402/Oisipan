@model GooglePasswordSetupViewModel
@{
    ViewData["Title"] = "Thiết Lập Mật Khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - OISIPAN</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page">
        <div class="login-container">
            <div class="login-card">
                <span class="subtitle">Đăng nhập Google lần đầu</span>
                <h1>Thiết lập mật khẩu</h1>

                <p class="text-muted mb-3">
                    Xin chào <strong>@Model.FullName</strong>. Vui lòng tạo mật khẩu cho email <strong>@Model.Email</strong>
                    để bạn có thể đăng nhập bằng cả Google và email/mật khẩu.
                </p>

                <form method="post" asp-action="SetGooglePassword" class="login-form" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="form-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="password-field">
                            <i class="bi bi-lock form-icon"></i>
                            <input asp-for="Password" type="password" class="form-control password-input" placeholder="Mật khẩu" autocomplete="new-password" />
                            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility(this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label>
                        <div class="password-field">
                            <i class="bi bi-lock form-icon"></i>
                            <input asp-for="ConfirmPassword" type="password" class="form-control password-input" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility(this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="submit-btn btn-login">Hoàn tất thiết lập</button>
                </form>

                <div class="signup-link">
                    <a href="@Url.Action("Login", "Account")">Quay lại đăng nhập</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>

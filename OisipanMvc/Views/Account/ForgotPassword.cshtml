@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên Mật Khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - OISIPAN</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="forgot-password-page">
        <div class="forgot-password-container">
            <div class="forgot-password-card">
                <h1>Quên Mật Khẩu?</h1>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="validation-summary-errors" style="background-color: #dcfce7; border-color: #86efac; color: #15803d;">
                        <i class="bi bi-check-circle"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="validation-summary-errors">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                <form method="post" asp-action="ForgotPassword" class="forgot-password-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="form-group">
                        <i class="bi bi-envelope form-icon"></i>
                        <input asp-for="Email" class="form-control" placeholder="Nhập Email đã đăng ký" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-telephone form-icon"></i>
                        <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="0xxxxxxxxx" />
                        <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <div class="password-field">
                            <i class="bi bi-lock form-icon"></i>
                            <input asp-for="NewPassword" type="password" class="form-control password-input" placeholder="Mật khẩu mới" />
                            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility(this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <div class="password-field">
                            <i class="bi bi-lock form-icon"></i>
                            <input asp-for="ConfirmPassword" type="password" class="form-control password-input" placeholder="Nhập lại Mật khẩu mới" />
                            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility(this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="submit-btn btn-submit">Xác Nhận</button>
                </form>

                <div class="back-to-login">
                    <a href="@Url.Action("Login", "Account")">Quay lại Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initializeFormValidation();
            initializeFormSubmission();
        });
    </script>
</body>
</html>
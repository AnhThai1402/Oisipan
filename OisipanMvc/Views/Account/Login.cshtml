@model LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - OISIPAN</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page">
        <div class="login-container">
            <div class="login-card">
                <span class="subtitle">Chào Mừng Trở Lại!</span>
                <h1>Đăng Nhập</h1>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="validation-summary-errors">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                <form method="post" asp-action="Login" class="login-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="form-group">
                        <label asp-for="Email">Tên tài khoản hoặc Email</label>
                        <i class="bi bi-envelope form-icon"></i>
                        <input asp-for="Email" class="form-control" placeholder="Tên tài khoản hoặc Email" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="password-field">
                            <i class="bi bi-lock form-icon"></i>
                            <input asp-for="Password" type="password" class="form-control password-input" placeholder="Mật khẩu" />
                            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility(this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="auth-row">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                        </div>
                        <a href="@Url.Action("ForgotPassword", "Account")" class="forgot-password-link">
                            Quên mật khẩu?
                        </a>
                    </div>

                    <button type="submit" class="submit-btn btn-login">Đăng Nhập</button>
                </form>

                <div class="divider">
                    <span>HOẶC</span>
                </div>

                <div class="social-buttons">
                    <button type="button" class="btn-social">
                        <i class="bi bi-google"></i> Google
                    </button>
                    <button type="button" class="btn-social">
                        <i class="bi bi-facebook"></i> Facebook
                    </button>
                </div>

                <div class="signup-link">
                    Chưa có tài khoản?
                    <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initializeFormValidation();
            initializeFormSubmission();
        });
    </script>
</body>
</html>
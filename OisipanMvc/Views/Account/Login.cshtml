@model LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
    Layout = null;
    var googleClientId = ViewBag.GoogleClientId as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - OISIPAN</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/google-login.css" asp-append-version="true" />
    <style>
        .phone-login-modal-close {
    position: absolute;
    top: 15px;
    right: 15px;

    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;
    border-radius: 50%;

    background: transparent;
    color: #666;

    cursor: pointer;

    font-size: 18px;

    z-index: 10;
}
.phone-login-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: none;
    align-items: center;
    justify-content: center;

    background: rgba(0, 0, 0, 0.55);
    padding: 20px;
}
.phone-login-container {
    width: 100%;
    margin-top: 15px;
}

.btn-phone-login {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    padding: 12px 20px;

    border: 1px solid #ddd;
    border-radius: 8px;

    background: #fff;
    color: #333;

    font-size: 15px;
    font-weight: 500;

    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-phone-login i {
    font-size: 17px;
}

.btn-phone-login:hover {
    background: #f8f8f8;
    border-color: #bbb;
    transform: translateY(-1px);
}

.btn-phone-login:active {
    transform: translateY(0);
}
    </style>
</head>
<body>
    <div class="login-page">
        <div class="login-container">
            <div class="login-card">
                <span class="subtitle">Chào Mừng Trở Lại!</span>
                <h1>Đăng Nhập</h1>

                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success">@successMessage</div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="validation-summary-errors">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                <form method="post" asp-action="Login" class="login-form" id="loginForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="form-group">
                        <label asp-for="Email">Tên tài khoản hoặc Email</label>
                        <i class="bi bi-envelope form-icon"></i>
                        <input asp-for="Email" class="form-control" placeholder="Tên tài khoản hoặc Email" autocomplete="email" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="password-field">
                            <i class="bi bi-lock form-icon"></i>
                            <input asp-for="Password" type="password" class="form-control password-input" placeholder="Mật khẩu" autocomplete="current-password" />
                            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility(this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="auth-row">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberPassword" />
                            <label asp-for="RememberMe" class="form-check-label" for="rememberPassword">Ghi nhớ đăng nhập</label>
                        </div>
                        <a href="@Url.Action("ForgotPassword", "Account")" class="forgot-password-link">
                            Quên mật khẩu?
                        </a>
                    </div>

                    <button type="submit" class="submit-btn btn-login">Đăng Nhập</button>
                </form>

                <div class="auth-divider">
                    <span>HOẶC</span>
                </div>

                <div class="google-signin-container">
    @if (!string.IsNullOrWhiteSpace(googleClientId))
    {
        <div id="google-signin-button"></div>
    }
    else
    {
        <div class="google-login-unavailable" role="status">
            Đăng nhập bằng Google hiện chưa được cấu hình.
        </div>
    }
</div>

<div class="phone-login-container">
    <button type="button"
            class="btn-phone-login"
            onclick="openPhoneLoginModal()">
        <i class="bi bi-telephone-fill"></i>
        Đăng nhập bằng số điện thoại
    </button>
</div>

<!-- Modal đăng nhập bằng số điện thoại -->
<div class="phone-login-modal-overlay"
     id="phoneLoginModal">

    <div class="phone-login-modal">

        <button type="button"
                class="phone-login-modal-close"
                onclick="closePhoneLoginModal()">
            <i class="bi bi-x-lg"></i>
        </button>

        @await Html.PartialAsync("PhoneLogin")

    </div>
</div>

                <div id="loading-overlay">
                    <div class="loading-spinner"></div>
                </div>

                <div class="signup-link">
                    Chưa có tài khoản?
                    <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </div>
    <script>
    function openPhoneLoginModal() {
        document.getElementById("phoneLoginModal").style.display = "flex";
    }

    function closePhoneLoginModal() {
        document.getElementById("phoneLoginModal").style.display = "none";
    }

    document.getElementById("phoneLoginModal")
        ?.addEventListener("click", function (e) {
            if (e.target === this) {
                closePhoneLoginModal();
            }
        });
</script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script src="~/js/google-login.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof initializeFormValidation === 'function') {
                initializeFormValidation();
            }
            if (typeof initializeFormSubmission === 'function') {
                initializeFormSubmission();
            }
        });

        window.addEventListener('load', function () {
            var clientId = '@googleClientId';
            if (clientId && window.GoogleLoginHandler) {
                GoogleLoginHandler.initialize(clientId);
            }
        });
    </script>
</body>
</html>

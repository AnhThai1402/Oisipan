@model ProductOptionManagementViewModel
@{
    ViewData["Title"] = "Quản lý biến thể";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="page-title-row">
    <div>
        <h1>Quản lý biến thể</h1>
        <p>Tìm sản phẩm để quản lý tùy chọn, giá trị và variants.</p>
    </div>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"></i>
        <div class="alert-content">@successMessage</div>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-error">
        <i class="bi bi-exclamation-circle-fill"></i>
        <div class="alert-content">@errorMessage</div>
    </div>
}

<form method="get"
      asp-area="Admin"
      asp-controller="ProductVariants"
      asp-action="Index"
      class="toolbar-panel variant-toolbar">
    <div class="form-group variant-filter product-search">
        <label for="productSelectInput">Chọn sản phẩm</label>
        <select name="productId"
                id="productSelectInput"
                class="form-input"
                onchange="this.form.submit()">
            <option value="">-- Chọn sản phẩm --</option>
            @foreach (var product in Model.Products)
            {
                <option value="@product.Value" selected="@(Model.SelectedProductId.HasValue && Model.SelectedProductId.Value.ToString() == product.Value)">@product.Text</option>
            }
        </select>
    </div>
</form>

@if (Model.SelectedProductId.HasValue)
{
    <div id="variant-flash" class="alert" style="display:none; margin-bottom:1rem;"></div>

    <section id="variants-root" data-product-id="@Model.SelectedProductId" data-product-name="@Model.SelectedProductName">
        <article class="panel">
            <div class="panel-head" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap: 1rem;">
                <h2 style="margin:0; font-size:1.25rem;">Danh sách biến thể</h2>
                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="AddVariant"
                   asp-route-id="@Model.SelectedProductId"
                   class="primary-action">
                    <i class="bi bi-plus-circle"></i> Thêm biến thể
                </a>
            </div>

            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Các thuộc tính</th>
                            <th style="width:150px;">Giá</th>
                            <th style="width:100px;">Tồn kho</th>
                            <th style="width:140px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="variant-tbody"></tbody>
                </table>
            </div>
        </article>
    </section>
}
else
{
    <section class="panel variant-empty-state">
        <i class="bi bi-boxes"></i>
        <strong>Hãy chọn một sản phẩm</strong>
        <span>Sau đó bạn có thể quản lý tùy chọn, giá trị và variants.</span>
    </section>
}

@section Scripts {
    @if (Model.SelectedProductId.HasValue)
    {
        <script src="~/js/admin-product-variants-list.js" asp-append-version="true"></script>
    }
}


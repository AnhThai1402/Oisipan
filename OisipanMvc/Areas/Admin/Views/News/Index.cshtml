@model List<FrontendMvc.Models.NewsArticleViewModel>

@{
    ViewData["Title"] = "Quản lý tin tức";
}

<section class="page-title-row">
    <div>
        <h1>Quản lý tin tức</h1>
    </div>
    <a class="primary-action"
       asp-area="Admin"
       asp-controller="News"
       asp-action="Create">
        <i class="bi bi-plus-circle"></i>
        Thêm tin tức
    </a>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="table-responsive admin-table-wrap">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Tin tức</th>
                <th>Ngày xuất bản</th>
                <th>Trạng thái</th>
                <th>Cập nhật</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var article in Model)
                {
                    <tr>
                        <td>
                            <div class="admin-product-cell">
                                @if (!string.IsNullOrWhiteSpace(article.Image))
                                {
                                    <img src="@article.Image" alt="@article.Title" />
                                }
                                <div>
                                    <strong>@article.Title</strong>
                                    <span>@article.Summary</span>
                                </div>
                            </div>
                        </td>
                        <td>@article.PublishedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="badge @(article.IsPublished ? "text-bg-success" : "text-bg-secondary")">
                                @(article.IsPublished ? "Đã xuất bản" : "Bản nháp")
                            </span>
                        </td>
                        <td>@article.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            @if (article.IsPublished)
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Home"
                                   asp-action="NewsDetail"
                                   asp-route-id="@article.NewsArticleId">Xem</a>
                            }
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Edit"
                               asp-route-id="@article.NewsArticleId">Sửa</a>
                            <form asp-action="Delete"
                                  asp-route-id="@article.NewsArticleId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa tin tức này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Chưa có tin tức nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

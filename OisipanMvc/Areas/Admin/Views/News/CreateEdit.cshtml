@model FrontendMvc.Models.NewsArticleViewModel

@{
    var isEdit = Model.NewsArticleId != 0;
    ViewData["Title"] = isEdit ? "Sửa tin tức" : "Thêm tin tức";
}

<section class="page-breadcrumb">
    <a asp-area="Admin" asp-controller="News" asp-action="Index">
        <i class="bi bi-house-door"></i> Tin tức
    </a>
    <span>/</span>
    <span>@(isEdit ? "Chỉnh sửa" : "Thêm mới")</span>
</section>

<section class="page-title-row">
    <div>
        <span class="eyebrow">@(isEdit ? "Chỉnh sửa" : "Thêm mới")</span>
        <h1>@ViewData["Title"]</h1>
        <p>@(isEdit ? "Cập nhật nội dung bài viết" : "Tạo bài viết mới cho trang tin tức Oishipan")</p>
    </div>
    <a asp-area="Admin" asp-controller="News" asp-action="Index" class="soft-action">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</section>

<form asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-id="@(isEdit ? Model.NewsArticleId : null)"
      method="post"
      enctype="multipart/form-data"
      class="news-form">
    <article class="panel news-form-panel">
        @if (Model.NewsArticleId != 0)
        {
            <input asp-for="NewsArticleId" type="hidden" />
        }

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <partial name="_NewsForm" model="Model" />

        <div class="form-actions">
            <a class="soft-action" asp-area="Admin" asp-controller="News" asp-action="Index">
                <i class="bi bi-x-circle"></i> Hủy
            </a>
            <button type="submit" class="primary-action">
                <i class="bi @(isEdit ? "bi-check-circle" : "bi-plus-circle")"></i>
                @(isEdit ? "Lưu thay đổi" : "Tạo tin tức")
            </button>
        </div>
    </article>
</form>

@section Styles {
}

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/translations/vi.js"></script>
    <script src="~/js/news-editor.js" asp-append-version="true"></script>
}

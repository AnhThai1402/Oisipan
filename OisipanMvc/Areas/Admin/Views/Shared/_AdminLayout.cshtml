@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string IsActive(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Oishipan Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-shell">
    <aside class="admin-sidebar" id="admin-sidebar">
        <div class="admin-brand">
            <div class="brand-mark">O</div>
            <div>
                <strong>Oishipan</strong>
                <span>Admin Suite</span>
            </div>
        </div>

        <nav class="admin-nav" aria-label="Admin navigation">
            <a class="@IsActive("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-chart-pie"></i><span>Tổng quan</span></a>
            <a class="@IsActive("Products")" asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="fa-solid fa-bread-slice"></i><span>Sản phẩm</span></a>
            <a class="@IsActive("ProductVariants")" asp-area="Admin" asp-controller="ProductVariants" asp-action="Index"><i class="fa-solid fa-shapes"></i><span>Biến thể</span></a>
            <a class="@IsActive("News")" asp-area="Admin" asp-controller="News" asp-action="Index"><i class="fa-solid fa-newspaper"></i><span>Tin tức</span></a>
            <a class="@IsActive("Vouchers")" asp-area="Admin" asp-controller="Vouchers" asp-action="Index"><i class="fa-solid fa-ticket"></i><span>Voucher</span></a>
            <a class="@IsActive("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="fa-solid fa-layer-group"></i><span>Danh mục</span></a>
            <a class="@IsActive("Orders")" asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="fa-solid fa-receipt"></i><span>Đơn hàng</span></a>
            <a class="@IsActive("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="fa-solid fa-users"></i><span>Người dùng</span></a>
        </nav>

        <div class="sidebar-card">
            <span>Doanh thu hôm nay</span>
            <strong>18.450.000đ</strong>
            <small>+12.8% so với hôm qua</small>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <button class="icon-action sidebar-toggle" id="sidebar-toggle" aria-label="Mở menu"><i class="fa-solid fa-bars"></i></button>
            <div class="admin-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" data-admin-search placeholder="Tìm nhanh mã đơn, sản phẩm, khách hàng..." />
            </div>
            <div class="topbar-actions">
                <button class="icon-action" id="density-toggle" title="Đổi mật độ hiển thị"><i class="fa-solid fa-table-cells"></i></button>
                <button class="icon-action" title="Thông báo"><i class="fa-regular fa-bell"></i><span class="dot"></span></button>
                <a class="admin-user" asp-area="" asp-controller="Home" asp-action="Index">
                    <span>Admin</span>
                    <strong>Quay về shop</strong>
                </a>
            </div>
        </header>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <div class="admin-overlay" id="admin-overlay"></div>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/money-input.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model FrontendMvc.Areas.Admin.Controllers.DashboardStatsDto
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<section class="admin-hero">
    <div>
        <h1>Bảng điều khiển</h1>
    </div>
    <button class="primary-action" onclick="window.print()"><i class="fa-solid fa-file-export"></i> Xuất báo cáo</button>
</section>

<section class="metric-grid">
    <article class="metric-card glow-green">
        <span>Doanh thu hôm nay</span>
        <strong>@Model.TodayRevenue.ToString("N0")đ</strong>
        <small>@Model.RecentOrders.Count đơn hàng</small>
    </article>
    <article class="metric-card glow-gold">
        <span>Đơn chờ xử lý</span>
        <strong>@Model.PendingOrders</strong>
        <small>@Model.ConfirmedOrders đơn cần xác nhận</small>
    </article>
    <article class="metric-card glow-red">
        <span>Sắp hết hàng</span>
        <strong>@Model.LowStockProducts</strong>
        <small>@Model.OutOfStockProducts hết hàng</small>
    </article>
    <article class="metric-card glow-blue">
        <span>Khách hàng</span>
        <strong>@Model.TotalCustomers</strong>
        <small>+@Model.NewCustomersThisMonth mới tháng này</small>
    </article>
</section>

<section class="admin-grid two-columns">
    <article class="panel">
        <div class="panel-head">
            <div><span class="eyebrow">Hiệu suất</span><h2>Doanh thu tháng</h2></div>
        </div>
        <div style="position: relative; height: 300px; margin-top: 1rem;">
            <canvas id="monthRevenueChart"></canvas>
        </div>
    </article>

    <article class="panel">
        <div class="panel-head">
            <div><span class="eyebrow">Việc cần làm</span><h2>Ưu tiên vận hành</h2></div>
        </div>
        <div class="task-list">
            <label><input type="checkbox"> Xác nhận @Model.PendingOrders đơn chờ</label>
            <label><input type="checkbox"> Kiểm tra @Model.LowStockProducts sản phẩm sắp hết</label>
            <label><input type="checkbox"> Duyệt voucher cuối tuần</label>
            <label><input type="checkbox"> Phản hồi yêu cầu đổi trả</label>
        </div>
    </article>
</section>

<section class="panel">
    <div class="panel-head">
        <div><span class="eyebrow">Đơn mới</span><h2>Đơn hàng hôm nay</h2></div>
        <a class="ghost-link" asp-area="Admin" asp-controller="Orders" asp-action="Index">Xem tất cả</a>
    </div>
    @if (Model.RecentOrders.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Giá trị</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái</th>
                        <th>ETA</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        var statusClass = order.Status switch
                        {
                            "Chờ xác nhận" => "pending",
                            "Đã xác nhận" => "confirmed",
                            "Đang chuẩn bị" => "preparing",
                            "Đang giao" => "shipping",
                            "Đã giao" => "completed",
                            _ => "pending"
                        };
                        <tr>
                            <td>
                                <a asp-area="Admin" asp-controller="Orders" asp-action="Detail" asp-route-id="@order.OrderId" style="text-decoration: none; color: inherit; font-weight: 500;">
                                    #@order.OrderCode
                                </a>
                            </td>
                            <td>@order.CustomerName</td>
                            <td>@order.TotalAmount.ToString("N0")đ</td>
                            <td>@order.PaymentMethod</td>
                            <td><span class="status @statusClass">@order.Status</span></td>
                            <td>@order.EstimatedDelivery</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding: 2rem; text-align: center; color: var(--text-muted);">
            <p><i class="bi bi-inbox"></i></p>
            <p style="margin: 0;">Không có đơn hàng hôm nay</p>
        </div>
    }
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const ctx = document.getElementById('monthRevenueChart')?.getContext('2d');
        if (ctx) {
            const dailyRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyRevenues));
            
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: dailyRevenues.map(d => d.date),
                    datasets: [{
                        label: 'Doanh thu (đ)',
                        data: dailyRevenues.map(d => d.revenue),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            labels: {
                                color: 'var(--text-main)',
                                font: { size: 12, weight: '500' },
                                padding: 15
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: 'var(--text-muted)',
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + 'đ';
                                }
                            },
                            grid: {
                                color: 'var(--border-color)'
                            }
                        },
                        x: {
                            ticks: {
                                color: 'var(--text-muted)'
                            },
                            grid: {
                                color: 'var(--border-color)'
                            }
                        }
                    }
                }
            });
        }
    </script>
}

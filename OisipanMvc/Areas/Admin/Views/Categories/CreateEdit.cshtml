@model FrontendMvc.Models.CategoryAdminViewModel
@{
    ViewData["Title"] = Model?.CategoryId != Guid.Empty ? "Chỉnh sửa danh mục" : "Thêm danh mục mới";
    var isEdit = Model?.CategoryId != Guid.Empty;
}

<section class="page-breadcrumb">
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-house-door"></i> Danh mục</a>
    <span>/</span>
    <span>@(isEdit ? "Chỉnh sửa" : "Thêm mới")</span>
</section>

<section class="page-title-row">
    <div>
        <span class="eyebrow">@(isEdit ? "Chỉnh sửa" : "Thêm mới")</span>
        <h1>@ViewData["Title"]</h1>
        <p>@(isEdit ? "Cập nhật thông tin danh mục" : "Tạo danh mục mới cho sản phẩm")</p>
    </div>
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="soft-action">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</section>

<form method="post" enctype="multipart/form-data" class="product-form-container">
    <input asp-for="CategoryId" type="hidden" />
    <input asp-for="Image" type="hidden" />

    <div class="admin-grid two-columns">
        <article class="panel">
            <div class="panel-head">
                <h2>Thông tin cơ bản</h2>
            </div>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label for="categoryName">Tên danh mục <span class="required">*</span></label>
                <input type="text"
                       id="categoryName"
                       name="CategoryName"
                       class="form-input"
                       value="@Model?.CategoryName"
                       placeholder="Ví dụ: Bánh ngọt Nhật"
                       required />
                <small class="form-hint">Tên danh mục hiển thị trên website.</small>
                <span asp-validation-for="CategoryName" class="field-validation-error"></span>
            </div>

            @if (Model?.ProductCount > 0)
            {
                <div class="metric-card glow-green admin-form-metric">
                    <span>Sản phẩm đang dùng danh mục này</span>
                    <strong>@Model.ProductCount</strong>
                    <small>Không nên xóa nếu danh mục vẫn còn sản phẩm.</small>
                </div>
            }
        </article>

        <article class="panel">
            <div class="panel-head">
                <h2>Hình ảnh</h2>
            </div>

            <div class="form-group">
                <label asp-for="ImageFile">Hình ảnh danh mục</label>
                <div class="file-upload-area">
                    <input asp-for="ImageFile"
                           id="categoryImage"
                           type="file"
                           accept="image/jpeg,image/png,image/webp,image/gif" />
                    <label for="categoryImage" class="file-upload-label">
                        <div class="upload-icon">
                            <i class="bi bi-cloud-arrow-up"></i>
                        </div>
                        <div class="upload-text">
                            <strong>Chọn hình ảnh hoặc kéo thả</strong>
                            <small>Hỗ trợ JPG, PNG, WEBP hoặc GIF, tối đa 4MB</small>
                        </div>
                    </label>
                    @if (!string.IsNullOrWhiteSpace(Model?.Image))
                    {
                        <div class="image-preview">
                            <img src="@Model.Image" alt="@Model.CategoryName" />
                            <button type="button" class="remove-image" title="Xóa"><i class="bi bi-x-circle-fill"></i></button>
                        </div>
                    }
                </div>
                <span asp-validation-for="ImageFile" class="field-validation-error"></span>
            </div>
        </article>
    </div>

    <div class="form-actions">
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="soft-action">
            <i class="bi bi-x-circle"></i> Hủy
        </a>
        <button type="submit" class="primary-action">
            <i class="bi bi-@(isEdit ? "pencil-square" : "plus-circle")"></i>
            @(isEdit ? "Cập nhật danh mục" : "Tạo danh mục")
        </button>
    </div>
</form>

@section Scripts {
    <script>
        document.getElementById('categoryImage')?.addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (readerEvent) {
                const uploadArea = document.querySelector('.file-upload-area');
                uploadArea.querySelector('.image-preview')?.remove();

                const preview = document.createElement('div');
                preview.className = 'image-preview';
                preview.innerHTML = `
                    <img src="${readerEvent.target.result}" alt="Preview" />
                    <button type="button" class="remove-image" title="Xóa"><i class="bi bi-x-circle-fill"></i></button>
                `;
                uploadArea.appendChild(preview);

                preview.querySelector('.remove-image').addEventListener('click', function () {
                    document.getElementById('categoryImage').value = '';
                    preview.remove();
                });
            };
            reader.readAsDataURL(file);
        });
    </script>
}

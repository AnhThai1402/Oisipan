@model IEnumerable<FrontendMvc.Models.CategoryAdminViewModel>
@{
    ViewData["Title"] = "Danh mục";
    var currentPage = (int?)ViewBag.CurrentPage ?? 1;
    var totalPages = (int?)ViewBag.TotalPages ?? 1;
    var totalItems = (int?)ViewBag.TotalItems ?? 0;
    var search = ViewBag.Search?.ToString();
}

@if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
{
    <div class="alert alert-success" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <div class="alert-content">
            @TempData["Message"]
        </div>
    </div>
}

<section class="page-title-row">
    <div>
        <h1>Quản lý danh mục</h1>
    </div>
    <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="primary-action">
        <i class="bi bi-plus-circle"></i> Thêm danh mục
    </a>
</section>

<section class="toolbar-panel">
    <form method="get" asp-area="Admin" asp-controller="Categories" asp-action="Index" class="search-bar-group" style="position: relative;">
        <input type="search" class="form-input" placeholder="Tìm danh mục..." id="categorySearch" name="search" value="@search" />
        <input type="hidden" name="page" value="1" />
        <i class="bi bi-search"></i>
    </form>
</section>

<section class="panel">
    <div class="table-wrapper">
        <table class="admin-table" id="categoryTable">
            <thead>
                <tr>
                    <th>Danh mục</th>
                    <th>Số sản phẩm</th>
                    <th style="width: 140px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    @foreach (var category in Model)
                    {
                        <tr onclick="window.location='@Url.Action("Detail", "Categories", new { area = "Admin", id = category.CategoryId })';" style="cursor: pointer;">
                            <td>
                                <div class="category-admin-cell">
                                    @if (!string.IsNullOrWhiteSpace(category.Image))
                                    {
                                        <img src="@category.Image" alt="@category.CategoryName" />
                                    }
                                    else
                                    {
                                        <span class="category-admin-fallback"><i class="bi bi-image"></i></span>
                                    }
                                    <strong>@category.CategoryName</strong>
                                </div>
                            </td>
                            <td><span class="badge badge-info">@category.ProductCount sản phẩm</span></td>
                            <td onclick="event.stopPropagation();">
                                <div class="action-buttons">
                                    <a asp-area="Admin" asp-controller="Categories" asp-action="Detail" asp-route-id="@category.CategoryId" class="icon-action" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                    <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.CategoryId" class="icon-action" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                    <form method="post" asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@category.CategoryId" class="delete-form" onsubmit="return showDeleteConfirm(event, '@category.CategoryName');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="icon-action danger delete-btn" title="Xóa"><i class="bi bi-trash-fill"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" style="text-align: center; padding: 40px;">
                            <i class="bi bi-inbox" style="font-size: 48px; color: var(--admin-line); margin-bottom: 16px; display: block;"></i>
                            <strong>Chưa có danh mục</strong>
                            <p style="color: var(--admin-muted);">Hãy tạo danh mục đầu tiên để bắt đầu</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (totalItems > 0)
{
    <div class="category-pagination-bar">
        <span>@totalItems danh mục · Trang @currentPage / @totalPages</span>
        <nav class="category-pagination" aria-label="Phân trang danh mục">
            @if (totalPages > 1 && currentPage > 1)
            {
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search" aria-label="Trang trước"><i class="bi bi-chevron-left"></i></a>
            }
            @if (totalPages > 1)
            {
                @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                {
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" asp-route-page="@pageNumber" asp-route-search="@search" class="@(pageNumber == currentPage ? "active" : "")">@pageNumber</a>
                }
            }
            @if (totalPages > 1 && currentPage < totalPages)
            {
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search" aria-label="Trang sau"><i class="bi bi-chevron-right"></i></a>
            }
        </nav>
    </div>
}

<div class="modal-overlay" id="deleteModal">
    <div class="modal-dialog modal-dialog-danger">
        <div class="modal-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h2 class="modal-title">Xóa danh mục?</h2>
        <p class="modal-message">Bạn có chắc chắn muốn xóa danh mục <strong id="categoryName"></strong>? Hành động này không thể hoàn tác.</p>
        <div class="modal-actions">
            <button type="button" class="btn-cancel" onclick="closeDeleteModal()">Hủy</button>
            <button type="button" class="btn-delete" onclick="confirmDelete()">Xóa danh mục</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let pendingForm = null;

        function showDeleteConfirm(event, categoryName) {
            event.preventDefault();
            pendingForm = event.target;
            document.getElementById('categoryName').textContent = categoryName;
            document.getElementById('deleteModal').classList.add('active');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('active');
            pendingForm = null;
        }

        function confirmDelete() {
            if (pendingForm) {
                pendingForm.submit();
            }
        }

        document.getElementById('deleteModal').addEventListener('click', function (event) {
            if (event.target === this) {
                closeDeleteModal();
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeDeleteModal();
            }
        });

    </script>
}

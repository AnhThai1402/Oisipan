@model FrontendMvc.Models.VoucherAdminViewModel
@{
    ViewData["Title"] = Model?.VoucherId != Guid.Empty ? "Chỉnh sửa Voucher" : "Tạo Voucher mới";
    var isEdit = Model?.VoucherId != Guid.Empty;
}

<section class="page-breadcrumb">
    <a asp-area="Admin" asp-controller="Vouchers" asp-action="Index"><i class="bi bi-house-door"></i> Voucher</a>
    <span>/</span>
    <span>@(isEdit ? "Chỉnh sửa" : "Thêm mới")</span>
</section>

<section class="page-title-row">
    <div>
        <span class="eyebrow">@(isEdit ? "Chỉnh sửa" : "Thêm mới")</span>
        <h1>@ViewData["Title"]</h1>
        <p>@(isEdit ? "Cập nhật điều kiện áp dụng mã giảm giá" : "Tạo mã giảm giá mới cho khách hàng")</p>
    </div>
    <a asp-area="Admin" asp-controller="Vouchers" asp-action="Index" class="soft-action">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</section>

<form method="post" class="product-form-container">
    @Html.AntiForgeryToken()
    <input asp-for="VoucherId" type="hidden" />

    <div class="admin-grid two-columns">
        <article class="panel">
            <div class="panel-head">
                <h2>Thông tin voucher</h2>
            </div>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label for="code">Mã voucher</label>
                <div class="input-with-action">
                    <input type="text"
                           id="code"
                           name="Code"
                           class="form-input"
                           value="@Model?.Code"
                           placeholder="Để trống để tự động tạo"
                           maxlength="20"
                           style="text-transform: uppercase;" />
                    <button type="button" class="soft-action compact-action" onclick="generateCode()">
                        <i class="bi bi-arrow-repeat"></i> Tự động
                    </button>
                </div>
                <small class="form-hint">Để trống nếu muốn hệ thống tự tạo mã ngẫu nhiên.</small>
                <span asp-validation-for="Code" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label for="name">Tên voucher <span class="required">*</span></label>
                <input type="text"
                       id="name"
                       name="Name"
                       class="form-input"
                       value="@Model?.Name"
                       placeholder="Ví dụ: Giảm giá mùa hè"
                       required />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="discountType">Loại giảm giá <span class="required">*</span></label>
                    <select id="discountType" name="DiscountType" class="form-input" onchange="updateDiscountAddon()">
                        <option value="Percentage" selected="@(Model?.DiscountType == "Percentage")">Phần trăm (%)</option>
                        <option value="Fixed" selected="@(Model?.DiscountType == "Fixed")">Số tiền (đ)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="discountValue">Giá trị giảm <span class="required">*</span></label>
                    <div class="input-with-icon suffix-input">
                        <input type="text"
                               id="discountValue"
                               name="DiscountValue"
                               class="form-input money-input"
                               inputmode="numeric"
                               value="@Model?.DiscountValue.ToString("0")"
                               required />
                        <span class="input-prefix" id="discountAddon">%</span>
                    </div>
                    <span asp-validation-for="DiscountValue" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="voucherType">Loại voucher</label>
                    <select id="voucherType" name="VoucherType" class="form-input">
                        <option value="Public" selected="@(Model?.VoucherType == "Public")">Công khai</option>
                        <option value="Private" selected="@(Model?.VoucherType == "Private")">Ẩn</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="distributionMethod">Cách phát voucher</label>
                    <select id="distributionMethod" name="DistributionMethod" class="form-input">
                        <option value="SaveOnPage" selected="@(Model?.DistributionMethod == "SaveOnPage")">Tự lưu trên trang</option>
                        <option value="ShareCode" selected="@(Model?.DistributionMethod == "ShareCode")">Gửi mã</option>
                    </select>
                </div>
            </div>
        </article>

        <article class="panel">
            <div class="panel-head">
                <h2>Điều kiện áp dụng</h2>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="maxDiscount">Giảm tối đa</label>
                    <div class="input-with-icon suffix-input">
                        <input type="text"
                               id="maxDiscount"
                               name="MaxDiscount"
                               class="form-input money-input"
                               inputmode="numeric"
                               value="@Model?.MaxDiscount.ToString("0")" />
                        <span class="input-prefix">đ</span>
                    </div>
                    <small class="form-hint">Nhập 0 nếu không giới hạn.</small>
                    <span asp-validation-for="MaxDiscount" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label for="minOrderValue">Đơn hàng tối thiểu</label>
                    <div class="input-with-icon suffix-input">
                        <input type="text"
                               id="minOrderValue"
                               name="MinOrderValue"
                               class="form-input money-input"
                               inputmode="numeric"
                               value="@Model?.MinOrderValue.ToString("0")" />
                        <span class="input-prefix">đ</span>
                    </div>
                    <span asp-validation-for="MinOrderValue" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="totalQuantity">Tổng số lượng <span class="required">*</span></label>
                    <input type="number"
                           id="totalQuantity"
                           name="TotalQuantity"
                           class="form-input"
                           value="@(Model?.TotalQuantity > 0 ? Model.TotalQuantity : 100)"
                           required
                           min="1" />
                    <span asp-validation-for="TotalQuantity" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label>Trạng thái</label>
                    <div class="radio-group">
                        <label class="radio-option">
                            <input type="radio" name="Status" value="Active" checked="@(string.IsNullOrEmpty(Model?.Status) || Model?.Status == "Active")" />
                            <span class="radio-custom"></span>
                            <strong>Hoạt động</strong>
                        </label>
                        <label class="radio-option">
                            <input type="radio" name="Status" value="Inactive" checked="@(Model?.Status == "Inactive")" />
                            <span class="radio-custom"></span>
                            <strong>Đã tắt</strong>
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="startDate">Ngày bắt đầu <span class="required">*</span></label>
                    <input type="datetime-local"
                           id="startDate"
                           name="StartDate"
                           class="form-input"
                           value="@(Model?.StartDate != null && Model.StartDate != DateTime.MinValue ? Model.StartDate.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))"
                           required />
                    <span asp-validation-for="StartDate" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label for="expiryDate">Ngày kết thúc <span class="required">*</span></label>
                    <input type="datetime-local"
                           id="expiryDate"
                           name="ExpiryDate"
                           class="form-input"
                           value="@(Model?.ExpiryDate != null && Model.ExpiryDate != DateTime.MinValue ? Model.ExpiryDate.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.AddMonths(1).ToString("yyyy-MM-ddTHH:mm"))"
                           required />
                    <span asp-validation-for="ExpiryDate" class="field-validation-error"></span>
                </div>
            </div>
        </article>
    </div>

    <div class="form-actions">
        <a asp-area="Admin" asp-controller="Vouchers" asp-action="Index" class="soft-action">
            <i class="bi bi-x-circle"></i> Hủy
        </a>
        <button type="submit" class="primary-action">
            <i class="bi bi-@(isEdit ? "pencil-square" : "plus-circle")"></i>
            @(isEdit ? "Cập nhật Voucher" : "Tạo Voucher")
        </button>
    </div>
</form>

@section Scripts {
    <script>
        function updateDiscountAddon() {
            const type = document.getElementById('discountType').value;
            const addon = document.getElementById('discountAddon');
            const maxDiscountInput = document.getElementById('maxDiscount');

            addon.textContent = type === 'Percentage' ? '%' : 'đ';
            maxDiscountInput.closest('.form-group').style.opacity = type === 'Percentage' ? '1' : '0.62';
        }

        function generateCode() {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let code = '';
            for (let i = 0; i < 8; i++) {
                code += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('code').value = code;
        }

        document.querySelectorAll('.money-input').forEach(input => {
            input.addEventListener('input', function (event) {
                let value = event.target.value.replace(/\D/g, '');
                if (event.target.id === 'discountValue' && document.getElementById('discountType').value === 'Percentage' && parseInt(value || '0') > 100) {
                    value = '100';
                }
                event.target.value = value ? parseInt(value).toLocaleString('vi-VN') : '';
            });

            if (input.value) {
                const value = input.value.replace(/\D/g, '');
                input.value = value ? parseInt(value).toLocaleString('vi-VN') : '';
            }

            input.closest('form').addEventListener('submit', function () {
                input.value = input.value.replace(/\D/g, '');
            });
        });

        document.addEventListener('DOMContentLoaded', updateDiscountAddon);
    </script>
}
